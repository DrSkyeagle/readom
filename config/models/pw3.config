# Kindle Paperwhite 3 (7th generation), stock firmware 5.16.2.1.1.
# What is true of this machine rather than of this port; everything else is in
# ../android-core.config. tools/build-kernel.sh picks this by PW3_KERNEL_MODEL
# and pairs it with imx60_wario_defconfig.

# 3G/1G user split (PAGE_OFFSET=0xC0000000), so the architecture's own ceiling
# for mmap randomisation is 16 bits. ARM_MMAP_BASE_RANDOMIZATION in the base
# fragment is what turns randomisation on; this is how far it can go here.
CONFIG_ARCH_MMAP_RND_BITS=16

# Atheros AR6003 over SDIO. The firmware-name and board-data policy of patch
# 0310 is about this chip; a board with another one leaves it unset.
CONFIG_LAB126_ANDROID_ATH6KL_FIRMWARE=y

# The kernel names itself, and /system/lib/modules is named after it. Never
# allow this image's module files to masquerade as stock-kernel modules, and
# never let a kernel built for another model call itself this one.
CONFIG_LOCALVERSION="-lab126-pw3-android81"
