# Candidate fragment for a NEW host-built PW3 Android kernel.
# This is not a complete Android port and must not be used as a flash recipe.
# Amazon stock source lacks Binder, ashmem and Android suspend/LMK plumbing;
# Includes the reviewed Android 8.1 core, alarm, wakeup and hardware adapters.
# Retain imx60_wario_defconfig hardware options; do not replace them with EVK config.
# The device component packer emits a gzip-compressed external initramfs.
# Kernel self-decompression does not enable external initramfs decompression.
# A prerequisite rather than a feature: the USB composite gadget and
# netfilter's qtaguid are both behind it, and either group could be edited
# without the other. Asking for it in one of them is how it ends up deleted
# with that group.
CONFIG_EXPERIMENTAL=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_RT_GROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_RESOURCE_COUNTERS=y
CONFIG_CGROUP_MEM_RES_CTLR=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_XATTR=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_AUDIT=y
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_SELINUX=y
CONFIG_ARM_MMAP_BASE_RANDOMIZATION=y
CONFIG_DEFAULT_SECURITY_SELINUX=y
CONFIG_DEFAULT_SECURITY="selinux"
# CONFIG_DEFAULT_SECURITY_DAC is not set
# Preserve enforcement ability; do not bypass missing policy integration.
# CONFIG_SECURITY_SELINUX_BOOTPARAM is not set
# CONFIG_SECURITY_SELINUX_DISABLE is not set
# CONFIG_SECURITY_SELINUX_DEVELOP is not set
# Retain no-kexec until a separate boot and recovery path is reviewed.
# CONFIG_KEXEC is not set
# Following options require source backports; currently absent from Amazon tree.
CONFIG_STAGING=y
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ASHMEM=y

# Android 8.1 Binder contexts, oom_score_adj LMK, and seccomp TSYNC.
# Match TARGET_USES_64_BIT_BINDER := false in the 32-bit AOSP 8.1 product.
CONFIG_ANDROID_BINDER_IPC_32BIT=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_AEABI=y
# CONFIG_OABI_COMPAT is not set
CONFIG_NET=y
CONFIG_ANDROID_LOW_MEMORY_KILLER=y
# CONFIG_ANDROID_LOW_MEMORY_KILLER_AUTODETECT_OOM_ADJ_VALUES is not set
# CONFIG_ANDROID_LOW_MEMORY_KILLER_RBTREE is not set

# AlarmManager, userspace wakeup sources, EPOLLWAKEUP and ADB FunctionFS.
CONFIG_TIMERFD=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_MAX77696=y
CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_SUSPEND=y
CONFIG_PM_WAKELOCKS=y
CONFIG_PM_WAKELOCKS_LIMIT=100
CONFIG_PM_WAKELOCKS_GC=y
CONFIG_EPOLL=y
# Reuse the PW3 ARC UDC. The Android composite gadget (patch 1040) carries MTP,
# PTP and, through the stock V1 FunctionFS inside it, adb; it registers the
# functionfs file system itself, so g_ffs is not built. Modules: arcotg_udc.ko
# and g_android.ko (docs/design/usb-mtp.md).
CONFIG_USB_GADGET=m
CONFIG_USB_GADGET_ARC=y
CONFIG_USB_ARC=m
CONFIG_USB_GADGET_DUALSPEED=y
CONFIG_USB_G_ANDROID=m
# CONFIG_USB_FUNCTIONFS is not set

# Android-only image. Never merge into stock/diagnostics/recovery configs.
CONFIG_LAB126_ANDROID_POWER_SUPPLY_ABI=y
CONFIG_WARIO_HALL_INPUT=y
CONFIG_LAB126_ANDROID_BACKLIGHT_BLANKING=y

# Zygote and vold use mount namespaces; procfd/setns needs the 0300 backport.
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_DEVPTS_MULTIPLE_INSTANCES=y
# Standard AOSP 8.1 emulated storage falls back to FUSE when sdcardfs is absent.
CONFIG_FUSE_FS=y

CONFIG_LAB126_ANDROID_DISABLE_TOUCH_FW_UPDATE=y
# Keep touch bus built-in; load only core/I2C/MT-B at runtime.
CONFIG_CYPRESS_CYTTSP4_BUS=y
CONFIG_TOUCHSCREEN_CYPRESS_CYTTSP4=m
CONFIG_TOUCHSCREEN_CYPRESS_CYTTSP4_I2C=m
CONFIG_TOUCHSCREEN_CYPRESS_CYTTSP4_MT_B=m
# CONFIG_TOUCHSCREEN_CYPRESS_CYTTSP4_LOADER is not set
# CONFIG_TOUCHSCREEN_CYPRESS_CYTTSP4_DEVICE_ACCESS is not set
# CONFIG_TOUCHSCREEN_CYPRESS_CYTTSP4_DEBUG_MODULE is not set
# CONFIG_TOUCHSCREEN_CYPRESS_CYTTSP4_INCLUDE_FW is not set
# CONFIG_TOUCHSCREEN_CYPRESS_CYTTSP4_AUTO_LOAD_TOUCH_PARAMS is not set

# PW3 Linux 3.0.35 / unmodified Android 8.1 netd candidate.
# Apply patches/series first. This file is a desired Kconfig fragment, not a
# generated .config or proof that STA/VPN/IPv6 works. Build all in (=y).
# Core socket/address-family and policy-routing requirements.
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_IPV6=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
# FIB_RULES is selected by the preceding options.
# netd always submits IPv4 and IPv6 rules; IPv4-only config is insufficient.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_RAW=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_RAW=y
CONFIG_NETFILTER_XT_MARK=y
# NFLOG listener uses NETLINK_NETFILTER. LOG selects NETFILTER_NETLINK, and
# XT_TARGET_NFLOG selects LOG. All three are stated here for auditability.
CONFIG_NETFILTER_NETLINK=y
CONFIG_NETFILTER_NETLINK_LOG=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y
# Android owner semantics on INPUT as well as OUTPUT, plus stats/tagging.
# qtaguid replaces owner revision 1; never enable both.
# CONFIG_NETFILTER_XT_MATCH_OWNER is not set
CONFIG_NETFILTER_TPROXY=y
CONFIG_NETFILTER_XT_MATCH_SOCKET=y
CONFIG_NETFILTER_XT_MATCH_QTAGUID=y
# Quotas/alerts become active when /proc/net/xt_qtaguid/ctrl is present.
CONFIG_NETFILTER_XT_MATCH_QUOTA2=y
CONFIG_NETFILTER_XT_MATCH_QUOTA2_LOG=y
# CONFIG_IP_NF_TARGET_ULOG is not set
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_TARGET_REJECT=y
# Framework prepares StrictController at daemon connection.
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_IPV4=y
CONFIG_NF_CONNTRACK_IPV6=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NETFILTER_XT_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_U32=y
# Android revision 1, including --send_nl_msg; patch required, not only config.
CONFIG_NETFILTER_XT_TARGET_IDLETIMER=y
# Standard IPv6 SLAAC privacy, optimistic DAD and router preference support.
CONFIG_IPV6_PRIVACY=y
CONFIG_IPV6_OPTIMISTIC_DAD=y
CONFIG_IPV6_ROUTER_PREF=y
CONFIG_IPV6_ROUTE_INFO=y
# Keep proc/sysfs interfaces usable by netd and framework; permissions/SELinux
# and Android init ownership remain user-space integration tasks.
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# Strict physical-panel waveform contract for the Android display HAL.
CONFIG_LAB126_ANDROID_EPDC=y

# Android Wi-Fi daemon groups, bounded and still checked by SELinux.
CONFIG_ANDROID_GID_NET_CAPABILITIES=y

# Enforce Android INTERNET permission through the framework-assigned inet group.
CONFIG_ANDROID_INET_GROUP_PERMISSION=y

# Temperature and display power callbacks must reject incomplete I2C transfers.
CONFIG_LAB126_ANDROID_PMIC_I2C_STRICT=y

# Keep factory IDME and calibration identifiers away from ordinary app UIDs.
CONFIG_LAB126_ANDROID_PRIVATE_IDENTIFIERS=y

# Temporary file-backed test: bound DM linear views to verified existing file extents.
# No RAID, crypt target, partition rewrite, or stock-kernel configuration change.
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y

# Compressed swap in RAM. Without any swap the kernel can only make room by
# dropping program code from the page cache or by killing applications: on
# Test V32 (511 MB) opening a second web page killed WeRead and the launcher,
# and a page load re-read 0.8-1.6 GB of code from flash. With a 256 MB zram
# device (loaded as a module for the measurement) the same sequence kept all
# three applications alive; 109 MB of idle data took 30 MB.
CONFIG_ZRAM=y

# Per-UID CPU time for BatteryStats: /proc/uid_cputime/show_uid_stat holds the
# user and system time of every UID, live threads and exited ones alike, which
# is how Android attributes battery use to applications (Android's own driver,
# patch 1053). Its exit accounting is a PROFILE_TASK_EXIT notifier, hence
# PROFILING, which by itself only adds those notifier calls to do_exit.
CONFIG_PROFILING=y
CONFIG_UID_CPUTIME=y

# The IPv4 nat table. netd creates its chains at every start, whether or not
# the device shares its connection, so without it every boot logged a failed
# iptables-restore (21 lines on Test V49). It is also what tethering would
# need. MASQUERADE is the one target netd uses (NatController).
CONFIG_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y

# Interfaces nothing here uses, and whose absence is one less way for a flaw
# elsewhere to reach the kernel. SELinux already denies all of them; these take
# the code out of the build. /dev/kmem maps kernel virtual memory, sys_sysctl
# is the deprecated binary interface to /proc/sys, and no process on an Android
# device creates a user namespace (3.0's is half-finished besides).
# STRICT_DEVMEM keeps /dev/mem to device registers, which is what a tool
# reading the i.MX6 clock registers needs; it is RAM that it stops.
# CC_STACKPROTECTOR and DEBUG_RODATA, which Android requires of later kernels,
# do not exist for ARM in 3.0.
# CONFIG_DEVKMEM is not set
# CONFIG_SYSCTL_SYSCALL is not set
# CONFIG_USER_NS is not set
CONFIG_STRICT_DEVMEM=y
# CONFIG_LOG_BUF_SHIFT stays at the defconfig's 15 (32 KB), and must. The ring
# sits at the fixed address of log_pos_goal, and the kernel that boots next
# copies it to /proc/printkbuf -- which is how a hang is read back after the
# watchdog resets into the stock system (patch 1043). The stock kernel copies
# its own log_buf_len, 32 KB, from that address: a larger ring here would hand
# it the first quarter of a circular buffer, which holds the newest messages
# only by chance, and 128 KB from 0x8fff0000 would also cross 0x90000000, where
# a failed reserve_bootmem silently moves the buffer somewhere the stock kernel
# does not look. The boot log is kept instead by ro.logd.kernel in pw3.mk: logd
# copies the whole ring into its own buffer when it starts, which is right
# after PreInit.c has reported what it did. Written out rather than left to the
# defconfig: merge-kconfig only adds to .config, so a value dropped from this
# fragment would stay in an output tree that already had it.
CONFIG_LOG_BUF_SHIFT=15
