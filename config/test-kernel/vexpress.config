# What a QEMU vexpress-a9 test kernel needs instead of the Kindle's hardware.
# Shared by both test kernels (tools/make-test-kernel-config.py); the base is
# ../android-core.config with the device's own drivers removed, so only the
# machine-shaped differences belong here.

# Both test kernels call themselves this, and the tests read the name out of
# the console banner ("Linux version 3.0.35-pw3-core-smoke"). It is not the
# name the device's kernel uses: config/models/pw3.config owns that one.
CONFIG_LOCALVERSION="-pw3-core-smoke"

# vexpress_defconfig does not expose the options below without it.
CONFIG_EXPERT=y

# The handoff plan is derived for a 3G/1G split, which is what the module's
# identity limit (boot/profiles/qemu-vexpress.json) is a number for.
CONFIG_VMSPLIT_3G=y
# CONFIG_VMSPLIT_2G is not set
# CONFIG_VMSPLIT_1G is not set

# How far mmap randomisation can go under that split, which is a fact about the
# split rather than about a board: the device's own value is in
# config/models/pw3.config, for the same 3G/1G reason. Without it here the test
# kernel took the architecture's minimum of 8 and `aslr-smoke default-is-16`
# failed -- the suite that found it had not run since the configuration was
# split in two.
CONFIG_ARCH_MMAP_RND_BITS=16

# The test initramfs carries no /dev; the kernel populates it.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# One CPU, as on the device, so a handoff that depends on the other cores
# being parked would pass here and fail there.
# CONFIG_SMP is not set

# Nothing in these tests has a screen, a speaker, a disk controller of the
# i.MX kind, or Amazon's Falcon framebuffer, and a hung-task warning during a
# deliberate 90-second QEMU timeout is noise.
# CONFIG_MFD_MXC_HDMI is not set
# CONFIG_SOUND is not set
# CONFIG_FB is not set
# CONFIG_ATA is not set
# CONFIG_DETECT_HUNG_TASK is not set
# CONFIG_FALCON is not set

# QEMU passes this; the ATAG command line replaces it when one is given.
CONFIG_CMDLINE="console=ttyAMA0 rdinit=/init"
