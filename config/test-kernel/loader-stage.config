# The loader-stage kernel: the first Linux of the handoff, the one that loads
# boot/handoff into itself and jumps to a second Linux
# (tools/build-loader-stage-kernel.sh, boot/profiles/qemu-vexpress.json).
# Everything else about it is the smoke kernel's configuration, which is why
# the two share config/test-kernel/vexpress.config.

# The whole point of this kernel: the handoff arrives as a module, exactly as
# it does on the device, where it is loaded into the stock kernel.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# The emulated SD card. boot/handoff/tests/run_client_test.py puts a FAT image
# on it and checks that the client unpacks its helper onto a real filesystem
# and cleans up afterwards -- on the device that filesystem is the user store.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_ARMMMCI=y
