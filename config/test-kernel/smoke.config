# The smoke kernel: one Linux, a diskless initramfs, and the kernel interface
# suite (tools/build-kernel-smoke.sh). It loads nothing and mounts nothing.

# Everything it runs is built in, so a module that failed to load could not be
# mistaken for a feature that is absent.
# CONFIG_MODULES is not set

# No block device of any kind is attached.
# CONFIG_MMC is not set
