-            update(mEnv.getContext().getResources().getText(R.string.cant_display_content), null,
-                    mEnv.getContext().getDrawable(R.drawable.cabinet));
+            update(mEnv.getContext().getResources().getText(R.string.cant_display_content),
+                    null, null);
         }
 
