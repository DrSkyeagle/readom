From: PW3 Android port
Subject: [PATCH] ART: use checked low-4GB allocation for Linux x86_64 hosts

The ARM64 build VM runs x86_64 dex2oat through QEMU linux-user. A real
MAP_32BIT probe returns a high address there, while a nonfixed low hint
works. Select ART's existing bounded allocator, retaining the dex2oat
debug checks and the original Android target-runtime selection.

--- a/runtime/mem_map.h
+++ b/runtime/mem_map.h
@@ -28,7 +28,11 @@
 
 namespace art {
 
-#if defined(__LP64__) && (defined(__aarch64__) || defined(__mips__) || defined(__APPLE__))
+// x86_64 host tools may run through Linux user-mode emulation, which can
+// ignore MAP_32BIT. Use ART's existing checked low-address allocator there.
+// Android target runtimes retain their original architecture selection.
+#if defined(__LP64__) && (defined(__aarch64__) || defined(__mips__) || defined(__APPLE__) || \
+    (defined(__x86_64__) && defined(__linux__) && !defined(__ANDROID__)))
 #define USE_ART_LOW_4G_ALLOCATOR 1
 #else
 #if defined(__LP64__) && !defined(__x86_64__)
