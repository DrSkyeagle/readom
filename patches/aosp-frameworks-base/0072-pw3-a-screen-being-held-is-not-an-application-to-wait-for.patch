                 mService.mHeldOverClosingApps.add(wtoken);
                 mService.mHeldOverOpeningApps.addAll(mService.mOpeningApps);
+                // Whatever is now being held on the screen is not something to
+                // wait for a first frame from. WeRead's launcher activity is
+                // in both sets without this line: it is the application that
+                // opens in the first transition and the screen that is held in
+                // the second, and being a trampoline it never draws. Measured
+                // on the device, 2026-11-03: mHeldOverOpeningApps held it and
+                // the shelf activity, so "all of them have drawn" was never
+                // true and the hold was never released.
+                mService.mHeldOverOpeningApps.removeAll(mService.mHeldOverClosingApps);
             } else {
                 wtoken.setVisibility(animLp, false, transit, false, voiceInteraction);
                 wtoken.updateReportedVisibilityLocked();
