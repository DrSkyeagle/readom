+<!-- Readom: the navigation bar's own hide button. A tap locks the bar hidden (patch 0076
+     takes it away at once), a long press brings it back. The icon is drawn rather than
+     tinted from AOSP's set because this panel is a black-on-white one. -->
+<ImageView
+    xmlns:android="http://schemas.android.com/apk/res/android"
+    android:id="@+id/readom_nav_hide"
+    android:layout_width="@dimen/navigation_key_width"
+    android:layout_height="match_parent"
+    android:layout_weight="0"
+    android:background="?android:attr/selectableItemBackground"
+    android:contentDescription="Hide navigation bar"
+    android:paddingTop="15dp"
+    android:paddingBottom="15dp"
+    android:paddingStart="@dimen/navigation_key_padding"
+    android:paddingEnd="@dimen/navigation_key_padding"
+    android:scaleType="fitCenter"
+    android:src="@drawable/readom_ic_sysbar_navhide"
+    />
