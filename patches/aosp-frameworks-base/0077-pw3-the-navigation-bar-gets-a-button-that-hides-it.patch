+<!-- Readom: the navigation bar's own key. One tap puts the bar away or brings it back
+     (patch 0076 owns that state). The icon is drawn rather than tinted from AOSP's set
+     because this panel is a black-on-white one. -->
+<ImageView
+    xmlns:android="http://schemas.android.com/apk/res/android"
+    android:id="@+id/readom_nav_hide"
+    android:layout_width="@dimen/navigation_key_width"
+    android:layout_height="match_parent"
+    android:layout_weight="0"
+    android:background="?android:attr/selectableItemBackground"
+    android:contentDescription="Hide or show the navigation bar"
+    android:paddingTop="15dp"
+    android:paddingBottom="15dp"
+    android:paddingStart="@dimen/navigation_key_padding"
+    android:paddingEnd="@dimen/navigation_key_padding"
+    android:scaleType="fitCenter"
+    android:src="@drawable/readom_ic_sysbar_navhide"
+    />
