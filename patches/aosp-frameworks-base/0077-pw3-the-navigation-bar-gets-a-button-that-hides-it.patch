@@ -307,6 +314,18 @@
         return v;
     }
 
+    /**
+     * Readom: asks the policy side (patch 0076) to hide the navigation bar and keep it hidden,
+     * or, for a long press, to let it back. The policy owns the setting and the bar state; this
+     * only says what the reader asked for. Any application can send the same broadcast; all it
+     * can do is hide the bar or bring it back, both of which the reader can undo.
+     */
+    private void readomSetNavLock(boolean locked) {
+        Intent intent = new Intent(READOM_NAV_ACTION);
+        intent.putExtra(READOM_NAV_EXTRA_LOCKED, locked);
+        getContext().sendBroadcast(intent);
+    }
+
     private View createView(String buttonSpec, ViewGroup parent, LayoutInflater inflater) {
         View v = null;
         String button = extractButton(buttonSpec);
@@ -328,6 +347,21 @@
             v = inflater.inflate(R.layout.back, parent, false);
         } else if (RECENT.equals(button)) {
             v = inflater.inflate(R.layout.recent_apps, parent, false);
+        } else if (NAVLOCK.equals(button)) {
+            v = inflater.inflate(R.layout.readom_nav_key, parent, false);
+            v.setOnClickListener(new View.OnClickListener() {
+                @Override
+                public void onClick(View view) {
+                    readomSetNavLock(true);
+                }
+            });
+            v.setOnLongClickListener(new View.OnLongClickListener() {
+                @Override
+                public boolean onLongClick(View view) {
+                    readomSetNavLock(false);
+                    return true;
+                }
+            });
         } else if (MENU_IME.equals(button)) {
