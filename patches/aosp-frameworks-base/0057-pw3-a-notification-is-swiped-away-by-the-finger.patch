+    private float updateGestureTranslation(MotionEvent ev) {
+        float delta = getPos(ev) - mGestureInitialTouchPos;
+        float absDelta = Math.abs(delta);
+        if (absDelta >= getFalsingThreshold()) {
+            mTouchAboveFalsingThreshold = true;
