+    /* Would running this transition now leave the screen with nothing on it?
+     *
+     * A transition that has run out of time runs anyway, and running it hides
+     * the applications on their way out (handleClosingApps below). That is the
+     * right thing when something else is going to be there -- the incoming
+     * application has drawn, or at least its starting window has. It is the
+     * wrong thing when neither is true: what is composed afterwards is the two
+     * system bars over nothing, which on e-paper is a black screen the reader
+     * is left in front of until the application finally draws. That is the
+     * defect of 2026-11-02, and raising the deadline to 45 s (patch 0067) only
+     * moved it later -- "you did not solve what happens when the 45 seconds run
+     * out; a blank page is no use" (the owner, 2026-11-03).
+     *
+     * Asked only after the deadline: a transition that is good to go on its own
+     * merits has, by definition, something to show.
+     *
+     * The deadline itself is kept. It is not a decision about the screen: while
+     * a transition is pending, committed visibility, window removal, the IME
+     * target and the priority boost are all deferred, and something has to let
+     * go if an application really is wedged. Leaving the screen empty is a side
+     * effect of letting go, not its purpose, so what changes here is the side
+     * effect and not the deadline. */
+    private boolean wouldLeaveTheScreenEmpty() {
+        if (!mService.mAppTransition.isTimeout()) {
+            return false;
+        }
+        if (!SystemProperties.getBoolean("debug.pw3.hold_screen_past_deadline",
+                SystemProperties.getBoolean("ro.pw3.hold_screen_past_deadline", true))) {
+            return false;
+        }
+        final int openingCount = mService.mOpeningApps.size();
+        if (openingCount == 0) {
+            // Nothing is opening. What the closing application uncovers is
+            // whatever was behind it, which is not this question.
+            return false;
+        }
+        for (int i = 0; i < openingCount; i++) {
+            if (hasSomethingOnScreen(mService.mOpeningApps.valueAt(i))) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static boolean hasSomethingOnScreen(AppWindowToken wtoken) {
+        return wtoken.allDrawn || wtoken.startingDisplayed;
+    }
+
+    /* Let go of the applications held on the screen past a deadline.
+     *
+     * Released -- hidden for real -- on the first surface placement in which
+     * every application that was opening has something on the screen of its
+     * own. What the reader is looking at by then is that application, so the
+     * screen underneath it can go.
+     *
+     * Dropped without hiding anything when those applications have lost their
+     * windows instead: killed, or the reader pressed Back. The activity manager
+     * owns that screen's visibility again, and hiding it here would be this
+     * method producing the blank screen the hold exists to prevent.
+     *
+     * If they neither draw nor go away, nothing happens and the previous screen
+     * stays. That is the point, and it is why nothing here is on a timer. */
+    private void releaseHeldOverClosingApps() {
+        if (mService.mHeldOverClosingApps.isEmpty()) {
+            return;
+        }
+        final int waitingCount = mService.mHeldOverOpeningApps.size();
+        boolean drawn = waitingCount > 0;
+        boolean gone = waitingCount > 0;
+        for (int i = 0; i < waitingCount; i++) {
+            final AppWindowToken wtoken = mService.mHeldOverOpeningApps.valueAt(i);
+            drawn &= hasSomethingOnScreen(wtoken);
+            gone &= wtoken.findMainWindow() == null;
+        }
+        if (!drawn && !gone) {
+            return;
+        }
+        if (drawn) {
+            for (int i = mService.mHeldOverClosingApps.size() - 1; i >= 0; i--) {
+                final AppWindowToken wtoken = mService.mHeldOverClosingApps.valueAt(i);
+                // performLayout false: this runs at the top of a surface
+                // placement that is about to lay out anyway, and asking for
+                // another one from in here calls performSurfacePlacement()
+                // before mInLayout is set, which is a recursive traversal.
+                wtoken.setVisibility(null, false, AppTransition.TRANSIT_UNSET,
+                        false /* performLayout */, wtoken.mVoiceInteraction);
+                wtoken.updateReportedVisibilityLocked();
+            }
+            mService.getDefaultDisplayContentLocked().setLayoutNeeded();
+        }
+        mService.mHeldOverClosingApps.clear();
+        mService.mHeldOverOpeningApps.clear();
+    }
