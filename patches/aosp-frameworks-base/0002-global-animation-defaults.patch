Subject: [PW3] Load all animation defaults into Global for new settings data

The legacy System table defaults do not feed WindowManager Global reads on
fresh Android 8.1 installs. Keep the upstream 100 percent fallback; PW3
overlays 0 percent. Existing XML settings and database upgrades are untouched.

--- a/packages/SettingsProvider/res/values/defaults.xml
+++ b/packages/SettingsProvider/res/values/defaults.xml
@@ -34,6 +34,7 @@
     <bool name="def_screen_brightness_automatic_mode">false</bool>
     <fraction name="def_window_animation_scale">100%</fraction>
     <fraction name="def_window_transition_scale">100%</fraction>
+    <fraction name="def_animator_duration_scale">100%</fraction>
     <bool name="def_haptic_feedback">true</bool>
 
     <bool name="def_bluetooth_on">true</bool>
--- a/packages/SettingsProvider/src/com/android/providers/settings/DatabaseHelper.java
+++ b/packages/SettingsProvider/src/com/android/providers/settings/DatabaseHelper.java
@@ -2319,8 +2319,6 @@
             loadBooleanSetting(stmt, Settings.System.SCREEN_BRIGHTNESS_MODE,
                     R.bool.def_screen_brightness_automatic_mode);
 
-            loadDefaultAnimationSettings(stmt);
-
             loadBooleanSetting(stmt, Settings.System.ACCELEROMETER_ROTATION,
                     R.bool.def_accelerometer_rotation);
 
@@ -2480,6 +2478,15 @@
         try {
             stmt = db.compileStatement("INSERT OR IGNORE INTO global(name,value)"
                     + " VALUES(?,?);");
+
+            // Global values are read by WindowManager on fresh installations.
+            // INSERT OR IGNORE and the existing migration path preserve user values.
+            loadFractionSetting(stmt, Settings.Global.WINDOW_ANIMATION_SCALE,
+                    R.fraction.def_window_animation_scale, 1);
+            loadFractionSetting(stmt, Settings.Global.TRANSITION_ANIMATION_SCALE,
+                    R.fraction.def_window_transition_scale, 1);
+            loadFractionSetting(stmt, Settings.Global.ANIMATOR_DURATION_SCALE,
+                    R.fraction.def_animator_duration_scale, 1);
 
             // --- Previously in 'system'
             loadBooleanSetting(stmt, Settings.Global.AIRPLANE_MODE_ON,
