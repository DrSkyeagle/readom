         android:layout_height="wrap_content" />
 
+    <!-- PW3: AOSP inflates this button into every row and refers to it from
+         nowhere (no R.id.veto in SystemUI 8.1); a height of zero and a margin of
+         -80dp keep it out of sight. It is what dismisses a notification here.
+         Swiping cannot be made to work on this panel: measured on V86, 700 px in
+         400 ms took the row away and the same 700 px in 900 ms did not, nor did
+         500 px in 600 ms, in either direction. A frame takes 134 to 463 ms, the
+         reader waits for it, and VelocityTracker keeps only the last 100 ms. A
+         button is a tap, and a tap is one frame. 56dp because it sits at the edge
+         of the screen (rule 7); top|end because the header's right half is empty
+         (the expand chevron is inline after the text, measured at x 270 to 360 of
+         1072). ExpandableNotificationRow gives it its click and its visibility. -->
     <Button
         android:id="@+id/veto"
-        android:layout_width="48dp"
-        android:layout_height="0dp"
-        android:gravity="end"
-        android:layout_marginEnd="-80dp"
