@@ -0,0 +1,9 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- PW3: the cross SystemUI already carries, inside the 56dp target rule 7
+     of docs/design/eink-ui.md asks for at the edge of the screen. The inset
+     leaves the glyph at the 24dp it is drawn for; stretching it to the whole
+     target would put a large black mark on a page that is mostly white
+     (rule 9). -->
+<inset xmlns:android="http://schemas.android.com/apk/res/android"
+       android:drawable="@drawable/ic_close"
+       android:inset="16dp" />
