+    /** The brightness value of a slider step: the steps divide the range evenly. */
+    private int stepToBrightness(int step) {
+        final int range = mMaximumBacklight - mMinimumBacklight;
+        return mMinimumBacklight + (2 * step * range + mSliderSteps) / (2 * mSliderSteps);
+    }
+
+    /** The slider step nearest to a brightness value, whoever set it. */
+    private int brightnessToStep(int brightness) {
+        final int range = mMaximumBacklight - mMinimumBacklight;
+        final int offset = Math.max(0, Math.min(range, brightness - mMinimumBacklight));
+        return (2 * offset * mSliderSteps + range) / (2 * range);
+    }
