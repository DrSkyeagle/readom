+    @Override
+    public void onBootPhase(int phase) {
+        if (phase == SystemService.PHASE_BOOT_COMPLETED
+                && SystemProperties.getBoolean(PREFETCH_RECENT_APP_PROPERTY, false)) {
+            // Its own thread: the reads take seconds and must not hold up the pinner handler.
+            new Thread(this::prefetchRecentApp, "PinnerPrefetch").start();
+        }
+    }
+
+    private void prefetchRecentApp() {
+        Process.setThreadPriority(Process.THREAD_PRIORITY_BACKGROUND);
+        ApplicationInfo app = getRecentAppInfo();
+        if (app == null) {
+            return;
+        }
+        String arch = "arm";
+        String abi = app.primaryCpuAbi != null ? app.primaryCpuAbi : Build.SUPPORTED_ABIS[0];
+        if (VMRuntime.is64BitAbi(abi)) {
+            arch = arch + "64";
+        }
+        String[] outputs = null;
+        try {
+            outputs = DexFile.getDexFileOutputPaths(app.getBaseCodePath(), arch);
+        } catch (IOException e) {
+        }
+        if (outputs == null) {
+            return;
+        }
+        // The .odex and .vdex, and the app image (.art) next to them if there is one.
+        ArrayList<File> files = new ArrayList<>();
+        for (String path : outputs) {
+            files.add(new File(path));
+            if (path.endsWith(".odex")) {
+                files.add(new File(path.substring(0, path.length() - 5) + ".art"));
+            }
+        }
+        ActivityManager.MemoryInfo memory = new ActivityManager.MemoryInfo();
+        mContext.getSystemService(ActivityManager.class).getMemoryInfo(memory);
+        long budget = memory.availMem / 2;
+        long start = SystemClock.uptimeMillis();
+        long done = 0;
+        byte[] buffer = new byte[1 << 20];
+        for (File file : files) {
+            long length = file.length();
+            if (length == 0 || done + length > budget) {
+                continue;
+            }
+            try (FileInputStream in = new FileInputStream(file)) {
+                while (in.read(buffer) > 0) {
+                }
+                done += length;
+            } catch (IOException e) {
+                Slog.w(TAG, "Could not prefetch " + file + ": " + e.getMessage());
+            }
+        }
+        Slog.i(TAG, "Prefetched " + app.packageName + ": " + (done >> 20) + " MB in "
+                + (SystemClock.uptimeMillis() - start) + " ms (budget " + (budget >> 20) + " MB)");
+    }
+
+    /** The app of the most recent task other than home, or null. */
+    private ApplicationInfo getRecentAppInfo() {
+        PackageManager pm = mContext.getPackageManager();
+        ResolveInfo home = pm.resolveActivity(new Intent(Intent.ACTION_MAIN)
+                .addCategory(Intent.CATEGORY_HOME), PackageManager.MATCH_DEFAULT_ONLY);
+        String homePackage = home != null && home.activityInfo != null
+                ? home.activityInfo.packageName : null;
+        List<ActivityManager.RecentTaskInfo> tasks = mContext.getSystemService(
+                ActivityManager.class).getRecentTasks(4, ActivityManager.RECENT_IGNORE_UNAVAILABLE);
+        for (ActivityManager.RecentTaskInfo task : tasks) {
+            ComponentName component = task.realActivity != null ? task.realActivity
+                    : task.baseIntent != null ? task.baseIntent.getComponent() : null;
+            if (component == null || component.getPackageName().equals(homePackage)) {
+                continue;
+            }
+            try {
+                return pm.getApplicationInfo(component.getPackageName(), 0);
+            } catch (PackageManager.NameNotFoundException e) {
+            }
+        }
+        return null;
+    }
