+    /**
+     * Whether the window's surface needs an alpha channel for its renderer.
+     * PW3: with the software canvas for every process (the same properties as
+     * in ActivityThread) FLAG_HARDWARE_ACCELERATED creates no renderer. An
+     * opaque window then gets an opaque surface, its canvas is opaque, and
+     * ViewRootImpl does not clear the dirty area before drawing each frame.
+     */
+    private static boolean usesRenderer(LayoutParams attrs) {
+        if ((attrs.flags & FLAG_HARDWARE_ACCELERATED) == 0) {
+            return false;
+        }
+        return !SystemProperties.getBoolean("debug.pw3.software_canvas",
+                SystemProperties.getBoolean("ro.pw3.software_canvas", false));
+    }
