+    /** Readom: forget a reveal; the bar goes back to being hidden. Called with the lock held. */
+    private void readomForgetRevealLw() {
+        mReadomNavReveal = false;
+        mHandler.removeCallbacks(mReadomNavHide);
+    }
+
+    /** Readom: take a revealed bar away at once. Called with the window manager lock held. */
+    private void readomHideNavBarLw() {
+        readomForgetRevealLw();
+        if (mNavigationBarController != null) {
+            mNavigationBarController.hideTransientNow();
+        }
+    }
+
+    /**
+     * Readom: set the lock, persist it, and apply it to the bar now.
+     * Called with the window manager lock held.
+     */
+    private void readomSetNavLockLw(boolean locked) {
+        final ContentResolver resolver = mContext.getContentResolver();
+        Settings.Global.putInt(resolver, READOM_NAV_LOCKED, locked ? 1 : 0);
+        // The bar is hidden through policy_control, the same global the boot service writes, so
+        // the button works whether or not this start began hidden.
+        Settings.Global.putString(resolver, Settings.Global.POLICY_CONTROL,
+                locked ? READOM_NAV_POLICY : null);
+        mReadomNavLock = locked;
+        if (locked) {
+            readomHideNavBarLw();
+        } else {
+            readomForgetRevealLw();
+        }
+        applyReadomNavBottomSwipeLw();
+        mWindowManagerFuncs.reevaluateStatusBarVisibility();
+    }
+
+    /** Readom: hand the bottom edge thresholds to the gesture listener, in pixels. */
+    private void applyReadomNavBottomSwipeLw() {
+        if (mSystemGestures == null) return;
+        if (mReadomNavLock) {
+            final float density = mContext.getResources().getDisplayMetrics().density;
+            mSystemGestures.setBottomSwipeThresholds(
+                    Math.round(READOM_NAV_BOTTOM_START_DP * density),
+                    Math.round(READOM_NAV_BOTTOM_DISTANCE_DP * density),
+                    READOM_NAV_BOTTOM_TIMEOUT_MS);
+        } else {
+            mSystemGestures.resetBottomSwipeThresholds();
+        }
+    }
 
