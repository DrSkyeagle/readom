+import android.graphics.Color;
 import android.os.Handler;
 import android.os.RemoteException;
 import android.os.Trace;
@@ -35,6 +36,7 @@
 import com.android.internal.colorextraction.types.Tonal;
 import com.android.keyguard.KeyguardUpdateMonitor;
 import com.android.systemui.Dumpable;
+import com.android.systemui.R;
 
 import java.io.FileDescriptor;
 import java.io.PrintWriter;
@@ -48,6 +50,9 @@
     private boolean mWallpaperVisible;
     // Colors to return when the wallpaper isn't visible
     private final GradientColors mWpHiddenColors;
+    // What is handed out instead of gradients, for use under dark and under
+    // light text; null: gradients.
+    private final GradientColors mPlainLight, mPlainDark;
 
     public SysuiColorExtractor(Context context) {
         this(context, new Tonal(context), true);
@@ -57,6 +62,12 @@
     public SysuiColorExtractor(Context context, ExtractionType type, boolean registerVisibility) {
         super(context, type);
         mWpHiddenColors = new GradientColors();
+        if (context.getResources().getBoolean(R.bool.config_gradientColors)) {
+            mPlainLight = mPlainDark = null;
+        } else {
+            mPlainLight = plain(Color.WHITE, true);
+            mPlainDark = plain(Color.BLACK, false);
+        }
 
         WallpaperColors systemColors = getWallpaperColors(WallpaperManager.FLAG_SYSTEM);
         updateDefaultGradients(systemColors);
@@ -160,11 +171,20 @@
         if (which == WallpaperManager.FLAG_LOCK) {
             ignoreWallpaperVisibility = true;
         }
-        if (mWallpaperVisible || ignoreWallpaperVisibility) {
-            return super.getColors(which, type);
-        } else {
-            return mWpHiddenColors;
-        }
+        final GradientColors colors = (mWallpaperVisible || ignoreWallpaperVisibility)
+                ? super.getColors(which, type) : mWpHiddenColors;
+        if (mPlainLight == null) {
+            return colors;
+        }
+        return colors.supportsDarkText() ? mPlainLight : mPlainDark;
+    }
+
+    private static GradientColors plain(int color, boolean supportsDarkText) {
+        final GradientColors colors = new GradientColors();
+        colors.setMainColor(color);
+        colors.setSecondaryColor(color);
+        colors.setSupportsDarkText(supportsDarkText);
+        return colors;
     }
 
