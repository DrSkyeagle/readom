--- /dev/null
+++ b/packages/SystemUI/res/values/pw3_eink.xml
@@ -0,0 +1,11 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- PW3: the e-paper interface rules (docs/design/eink-ui.md) as SystemUI uses them. The
+     framework's dialogs, menus and toasts, Settings and Launcher3 write the same values.
+     SystemUI is drawn in software, where no shadow is drawn: what floats above the page
+     has a solid outline instead. -->
+<resources>
+    <color name="pw3_outline">#ff000000</color>
+    <!-- 2 px on PW3 (density 1.875, rounded to whole pixels). -->
+    <dimen name="pw3_outline_width">1dp</dimen>
+    <dimen name="pw3_corner_radius">4dp</dimen>
+</resources>
