+
+    /**
+     * PW3: the version of the home screen layout this image carries.
+     *
+     * It is a resource rather than a constant here because the thing it is the
+     * version of is a resource, and whoever edits the layout is looking at
+     * res/, not at this file. SCHEMA_VERSION above says why the two numbers are
+     * not one number.
+     */
+    private int shippedLayoutVersion() {
+        return getContext().getResources().getInteger(R.integer.pw3_workspace_layout_version);
+    }
+
+    /**
+     * PW3: gives a home screen that already exists the entries a newer layout
+     * has added to it, and leaves everything else alone.
+     *
+     * Only the layout of this image: an app restriction, a package from the
+     * Play Store and a partner APK are all somebody's deliberate override of
+     * the home screen, this device carries none of the three, and the entries
+     * of this image have no business arriving on top of an override. A
+     * workspace seeded from one of those records this version above and is then
+     * left as it is.
+     *
+     * A layout that cannot be read is said so and tried again on the next load:
+     * that is a build which should not have shipped, and recording the version
+     * would hide it. The same for anything thrown below, and for the same
+     * reason it is caught at all -- this runs before the workspace is read
+     * (LoaderTask.loadWorkspace), on every device that installs this release, so
+     * an exception here is a home screen that does not come up, and the home
+     * screen is the whole interface of this device. Trying again is safe because
+     * the pass is idempotent: what it has already inserted is on the screen the
+     * next time it looks, and is passed over.
+     */
+    private void applyWhatTheLayoutGainedSinceThen(SharedPreferences sp) {
+        int shipped = shippedLayoutVersion();
+        int applied = sp.getInt(LAYOUT_VERSION_APPLIED, 0);
+        if (applied == shipped) {
+            return;
+        }
+        int added;
+        try {
+            added = mOpenHelper.loadWhatIsMissing(mOpenHelper.getWritableDatabase(),
+                    getDefaultLayoutParser(mOpenHelper.newLauncherWidgetHost()));
+        } catch (RuntimeException e) {
+            Log.e(TAG, "the home screen layout could not be applied; layout version "
+                    + shipped + " is not recorded", e);
+            return;
+        }
+        if (added < 0) {
+            Log.e(TAG, "the home screen layout could not be read; layout version "
+                    + shipped + " is not recorded");
+            return;
+        }
+        FileLog.d(TAG, "home screen layout " + applied + " to " + shipped + ": "
+                + added + " entries added");
+        sp.edit().putInt(LAYOUT_VERSION_APPLIED, shipped).commit();
     }
 
