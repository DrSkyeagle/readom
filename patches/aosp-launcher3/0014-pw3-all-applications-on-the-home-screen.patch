     public static final boolean IS_DEBUG_DEVICE = Build.TYPE.toLowerCase().contains("debug");
 
+    /**
+     * PW3: the action of the home screen's entry for the list of all applications
+     * (res/xml/default_workspace_pw3.xml). It names no activity and nothing ever starts
+     * it: the launcher reads it and opens the list in place
+     * (Launcher.startAppShortcutOrInfoActivity). A swipe up opens the same list, and
+     * since 0006 nothing on the screen says so, which is what the entry is for.
+     */
+    public static final String ACTION_ALL_APPS_ENTRY = "org.readom.action.ALL_APPS";
+
+    /** PW3: whether this is the home screen's entry for all applications. */
+    public static boolean isAllAppsEntry(ItemInfo info) {
+        return info != null && isAllAppsEntry(info.getIntent());
+    }
+
+    /** PW3: whether this is the intent of that entry. */
+    public static boolean isAllAppsEntry(Intent intent) {
+        return intent != null && ACTION_ALL_APPS_ENTRY.equals(intent.getAction());
+    }
