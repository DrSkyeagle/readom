--- a/src/com/android/packageinstaller/InstallInstalling.java
+++ b/src/com/android/packageinstaller/InstallInstalling.java
@@ -30,8 +30,10 @@
 import android.os.Bundle;
 import android.support.annotation.Nullable;
 import android.util.Log;
+import android.view.View;
 import android.widget.Button;
 import android.widget.ProgressBar;
+import android.widget.TextView;
 
 import com.android.internal.content.PackageHelper;
 
@@ -74,6 +76,18 @@
     /** The button that can cancel this dialog */
     private Button mCancelButton;
 
+    /**
+     * PW3: once the package manager has had the package this long, the text below the
+     * progress bar says why it can take long. Ten seconds is where a wait stops holding
+     * the user's attention and needs to say when it will end (Nielsen, Usability
+     * Engineering, 1993). The package manager compiles the app before it reports, with
+     * the bar standing still: 20 minutes for WeRead (70.5 MB of dex) on this hardware.
+     */
+    private static final long SLOW_INSTALL_HINT_DELAY_MS = 10 * 1000;
+
+    private final Runnable mShowSlowInstallHint = () ->
+            ((TextView) findViewById(R.id.center_text)).setText(R.string.installing_slow);
+
     @Override
     protected void onCreate(@Nullable Bundle savedInstanceState) {
         super.onCreate(savedInstanceState);
@@ -222,6 +236,7 @@
                 // we will receive a broadcast when the install is finished
                 mCancelButton.setEnabled(false);
                 setFinishOnTouchOutside(false);
+                scheduleSlowInstallHint();
             }
         }
     }
@@ -265,10 +280,17 @@
         }
 
         InstallEventReceiver.removeObserver(this, mInstallId);
+        findViewById(R.id.center_text).removeCallbacks(mShowSlowInstallHint);
 
         super.onDestroy();
     }
 
+    private void scheduleSlowInstallHint() {
+        View text = findViewById(R.id.center_text);
+        text.removeCallbacks(mShowSlowInstallHint);
+        text.postDelayed(mShowSlowInstallHint, SLOW_INSTALL_HINT_DELAY_MS);
+    }
+
     /**
      * Launch the appropriate finish activity (success or failed) for the installation result.
      *
@@ -398,6 +420,7 @@
                 session.commit(pendingIntent.getIntentSender());
                 mCancelButton.setEnabled(false);
                 setFinishOnTouchOutside(false);
+                scheduleSlowInstallHint();
