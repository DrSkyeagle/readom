--- /dev/null
+++ b/res/values/pw3_eink.xml
@@ -0,0 +1,8 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- PW3: the e-paper interface rules (docs/design/eink-ui.md) as this application
+     uses them. Settings, SystemUI and Launcher3 write the same values. -->
+<resources>
+    <color name="pw3_outline">#ff000000</color>
+    <!-- 2 px on PW3 (density 1.875, rounded to whole pixels). -->
+    <dimen name="pw3_outline_width">1dp</dimen>
+</resources>
--- /dev/null
+++ b/res/drawable/pw3_bottom_rule.xml
@@ -0,0 +1,18 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- PW3: a header band of the page's own white, with the rule that marks its
+     lower edge (docs/design/eink-ui.md). Material tells such a band from the
+     content below it with elevation, and software rendering draws no elevation
+     shadow at all, so without this the header has no edge; rule 3 marks it with
+     the outline instead. -->
+<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
+    <item>
+        <shape android:shape="rectangle">
+            <solid android:color="@color/pw3_outline" />
+        </shape>
+    </item>
+    <item android:bottom="@dimen/pw3_outline_width">
+        <shape android:shape="rectangle">
+            <solid android:color="?android:attr/colorPrimary" />
+        </shape>
+    </item>
+</layer-list>
