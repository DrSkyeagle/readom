+// PW3: where a new artifact is built while the one it replaces is still in use.
+//
+// open_output_file(recreate) unlinks the old file and creates another in its
+// place, so from that moment until dex2oat finishes the path holds a partial
+// file: dumpsys reports the package "invalid" and every process started in that
+// window runs interpreted. On a phone the job that compiles waits for a device
+// that is idle and on a charger, so the window belongs to nobody. On a Kindle,
+// which is rarely on a charger and where one large application takes about
+// twenty minutes to compile, the window is the owner's -- and a compile that is
+// interrupted leaves the application with no compiled code at all, which is
+// slower than never having started.
+//
+// So each artifact is built beside the one it replaces and renamed over it once
+// dex2oat has succeeded. rename() inside a directory is atomic, which is what
+// makes the invariant hold: at every instant the application has either the
+// code it had before or the code just built, and never neither.
+static std::string staging_path(const std::string& path) {
+    return path + ".staging";
+}
+
+// PW3: whether what was staged for `path` is there to be committed.
+//
+// `staged` is what this run did, not what is on the disk. The difference
+// matters: installd killed outright leaves a staging file nobody cleaned up,
+// and a later run that stages nothing for that path -- an app image is not
+// built unless the filter is profile-guided -- would otherwise find the
+// leftover and publish it beside an oat it does not belong to. So a path this
+// run did not stage is never committed, and a path it did stage and cannot find
+// is an error rather than a shrug.
+static bool staged_ready(const std::string& path, bool staged) {
+    if (!staged || path.empty()) {
+        return true;
+    }
+    const std::string from(staging_path(path));
+    if (access(from.c_str(), F_OK) != 0) {
+        PLOG(ERROR) << "installd staged nothing at " << from;
+        return false;
+    }
+    return true;
+}
+
+// PW3: put one staged artifact in place.
+//
+// The file is flushed before it is renamed, so that a power cut cannot leave the
+// name pointing at contents that never reached the disk. The directory is
+// deliberately not flushed afterwards: a rename lost to a power cut leaves the
+// old artifact in place, which is the right way for this to fail.
+//
+// Callers check every path with staged_ready() before committing any of them,
+// so that a missing file is found while the old set is still whole. What is
+// left after that is a rename failing on a filesystem that has stopped taking
+// writes, and then the set can be mixed: ART answers a mismatched oat and vdex
+// with kOatDexOutOfDate, which means the application interprets until something
+// compiles it again, rather than failing to start.
+static bool commit_staged(int fd, const std::string& path, bool staged) {
+    if (!staged || path.empty()) {
+        return true;
+    }
+    const std::string from(staging_path(path));
+    if (fd >= 0 && fsync(fd) != 0) {
+        PLOG(ERROR) << "installd could not flush " << from;
+        return false;
+    }
+    if (rename(from.c_str(), path.c_str()) != 0) {
+        PLOG(ERROR) << "installd could not put " << from << " in place";
+        return false;
+    }
+    return true;
+}
