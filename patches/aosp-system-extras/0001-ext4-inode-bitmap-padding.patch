From: PW3 Android port
Subject: [PATCH] ext4_utils: mark inode bitmap tail bits unavailable

The actual system image fails read-only e2fsck because initialized inode
bitmaps leave bits beyond inodes_per_group clear. Initialize these bits
as unavailable, matching the target kernel ext4_init_inode_bitmap contract.
Do this in the image producer; do not repair an already generated image.

--- a/ext4_utils/allocate.c
+++ b/ext4_utils/allocate.c
@@ -285,15 +285,25 @@
 static void init_bg(struct block_group_info *bg, unsigned int i)
 {
 	int header_blocks = 2 + aux_info.inode_table_blocks;
+	u32 bit;
 
 	bg->has_superblock = ext4_bg_has_super_block(i);
 
 	if (bg->has_superblock)
 		header_blocks += 1 + aux_info.bg_desc_blocks + info.bg_desc_reserve_blocks;
 
+	if (info.inodes_per_group > info.block_size * 8)
+		critical_error("inode count exceeds bitmap capacity");
 	bg->bitmaps = calloc(info.block_size, 2);
+	if (bg->bitmaps == NULL)
+		critical_error_errno("calloc");
 	bg->block_bitmap = bg->bitmaps;
 	bg->inode_bitmap = bg->bitmaps + info.block_size;
+
+	/* Bits outside the inode range are unavailable, including the tail of
+	 * an otherwise initialized inode bitmap. Match ext4_init_inode_bitmap. */
+	for (bit = info.inodes_per_group; bit < info.block_size * 8; bit++)
+		bitmap_set_bit(bg->inode_bitmap, bit);
 
 	bg->header_blocks = header_blocks;
 	bg->first_block = aux_info.first_data_block + i * info.blocks_per_group;
