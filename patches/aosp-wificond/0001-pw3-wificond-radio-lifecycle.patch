--- /dev/null
+++ b/pw3_radio.h
@@ -0,0 +1,8 @@
+#pragma once
+
+namespace android {
+namespace wificond {
+// Synchronous request to init. Success requires actual module/interface state.
+bool Pw3SetRadioEnabled(bool enabled);
+}  // namespace wificond
+}  // namespace android
--- /dev/null
+++ b/pw3_radio.cpp
@@ -0,0 +1,92 @@
+#include "wificond/pw3_radio.h"
+
+#include <cerrno>
+#include <cstring>
+#include <net/if.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <android-base/logging.h>
+#include <cutils/properties.h>
+
+namespace android {
+namespace wificond {
+namespace {
+constexpr const char* kModule = "/sys/module/ath6kl_sdio";
+constexpr const char* kDriver = "/sys/class/net/wlan0/phy80211/device/driver";
+constexpr const char* kModuleProperty = "vendor.pw3.wifi.modules";
+constexpr const char* kExpectedDriver = "ath6kl_sdio";
+
+bool ReadModuleState(bool* exists) {
+  struct stat st {};
+  if (stat(kModule, &st) == 0) {
+    if (!S_ISDIR(st.st_mode)) return false;
+    *exists = true;
+    return true;
+  }
+  if (errno != ENOENT) return false;
+  *exists = false;
+  return true;
+}
+
+bool ReadInterfaceState(bool* exists) {
+  // AOSP 8.1 Bionic preserves socket/ioctl errno. On this kernel SIOCGIFINDEX
+  // reports ENODEV for an absent name; other failures are not absence.
+  errno = 0;
+  const unsigned index = if_nametoindex("wlan0");
+  if (index != 0) {
+    *exists = true;
+    return true;
+  }
+  if (errno != ENODEV) return false;
+  *exists = false;
+  return true;
+}
+
+bool InterfaceMatches() {
+  char target[256] = {};
+  const ssize_t count = readlink(kDriver, target, sizeof(target) - 1);
+  if (count <= 0 || static_cast<size_t>(count) >= sizeof(target) - 1) return false;
+  target[count] = '\0';
+  const char* name = strrchr(target, '/');
+  return name && strcmp(name + 1, kExpectedDriver) == 0;
+}
+
+bool ReachedState(bool enabled) {
+  bool module_exists = false;
+  bool interface_exists = false;
+  if (!ReadModuleState(&module_exists) || !ReadInterfaceState(&interface_exists))
+    return false;
+  if (enabled) return module_exists && interface_exists && InterfaceMatches();
+  return !module_exists && !interface_exists;
+}
+
+bool WaitForState(bool enabled) {
+  // At most 300 sleeps (about 15 seconds); interrupted sleeps only shorten
+  // this deadline and never turn an unverified transition into success.
+  for (unsigned retry = 0; retry < 300; ++retry) {
+    if (ReachedState(enabled)) return true;
+    usleep(50000);
+  }
+  return ReachedState(enabled);
+}
+}  // namespace
+
+bool Pw3SetRadioEnabled(bool enabled) {
+  if (ReachedState(enabled)) return true;
+  if (property_set(kModuleProperty, enabled ? "load" : "unload") != 0) {
+    LOG(ERROR) << "PW3 radio module request rejected";
+    return false;
+  }
+  if (WaitForState(enabled)) return true;
+  LOG(ERROR) << "PW3 radio module transition did not reach verified state";
+  // A failed load can leave a bound-but-unusable module. Ask init to remove it;
+  // failed cleanup remains visible, and this function still returns false.
+  if (enabled) {
+    if (property_set(kModuleProperty, "unload") != 0 || !WaitForState(false))
+      LOG(ERROR) << "PW3 radio failed-load cleanup also failed";
+  }
+  return false;
+}
+}  // namespace wificond
+}  // namespace android
