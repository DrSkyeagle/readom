+package com.android.settings.inputmethod;
+
+import android.content.Context;
+import android.content.pm.PackageManager;
+import android.view.InputDevice;
+
+/**
+ * Whether a pointing device or a hardware keyboard can be used here: one is connected, or
+ * the device has a way to connect one (USB host, Bluetooth). Their settings do nothing
+ * otherwise.
+ */
+public final class InputDeviceAvailability {
+    private InputDeviceAvailability() {}
+
+    public static boolean canHavePointer(Context context) {
+        return canConnect(context) || hasDevice(InputDevice.SOURCE_MOUSE, false)
+                || hasDevice(InputDevice.SOURCE_TOUCHPAD, false);
+    }
+
+    public static boolean canHaveKeyboard(Context context) {
+        return canConnect(context) || hasDevice(InputDevice.SOURCE_KEYBOARD, true);
+    }
+
+    private static boolean canConnect(Context context) {
+        final PackageManager pm = context.getPackageManager();
+        return pm.hasSystemFeature(PackageManager.FEATURE_USB_HOST)
+                || pm.hasSystemFeature(PackageManager.FEATURE_BLUETOOTH);
+    }
+
+    private static boolean hasDevice(int source, boolean fullKeyboard) {
+        for (int id : InputDevice.getDeviceIds()) {
+            final InputDevice device = InputDevice.getDevice(id);
+            if (device != null && !device.isVirtual() && device.supportsSource(source)
+                    && (!fullKeyboard || device.isFullKeyboard())) {
+                return true;
+            }
+        }
+        return false;
+    }
+}
