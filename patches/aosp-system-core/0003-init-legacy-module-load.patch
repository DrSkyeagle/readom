 static constexpr std::chrono::nanoseconds kCommandRetryTimeout = 5s;
 
+// Older kernels expose init_module but not the fd-based finit_module syscall.
+// Keep the already-open descriptor and reject unsupported force-load flags.
+static int insmod_legacy(int fd, const char* options) {
+    struct stat st {};
+    if (fstat(fd, &st) == -1) return -1;
+    constexpr off_t kMaxLegacyModuleBytes = 32 * 1024 * 1024;
+    if (!S_ISREG(st.st_mode) || st.st_size <= 0) {
+        errno = EINVAL;
+        return -1;
+    }
+    if (st.st_size > kMaxLegacyModuleBytes) {
+        errno = EFBIG;
+        return -1;
+    }
+    void* image = malloc(static_cast<size_t>(st.st_size));
+    if (image == nullptr) {
+        errno = ENOMEM;
+        return -1;
+    }
+    int rc = -1;
+    if (android::base::ReadFully(fd, image, static_cast<size_t>(st.st_size))) {
+        rc = syscall(__NR_init_module, image, static_cast<size_t>(st.st_size), options);
+    } else {
+        errno = EIO;
+    }
+    const int saved_errno = errno;
+    free(image);
+    errno = saved_errno;
+    return rc;
+}
