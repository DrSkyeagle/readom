+    const int resume = wait_for_gdb ? SIGSTOP : (fatal_signal ? signo : 0);
+    if (ptrace(PTRACE_DETACH, main_tid, 0, resume) != 0) {
+      PLOG(ERROR) << "failed to detach from " << main_tid;
+    }
+    for (size_t i = 0; i < g_compat_count; ++i) {
+      if (g_compat_tids[i] != main_tid && ptrace(PTRACE_DETACH, g_compat_tids[i], 0, 0) != 0) {
+        PLOG(ERROR) << "failed to detach from " << g_compat_tids[i];
