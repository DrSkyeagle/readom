+/* Match upstream hidepid: the configured group or ptrace access may inspect tasks. */
+static bool has_pid_permissions(struct pid_namespace *pid,
+				struct task_struct *task, int hide_pid_min)
+{
+	if (pid->hide_pid < hide_pid_min)
+		return true;
+	if (in_group_p(pid->pid_gid))
+		return true;
+	return ptrace_may_access(task, PTRACE_MODE_READ);
+}
+
+static int proc_pid_permission(struct inode *inode, int mask, unsigned int flags)
+{
+	struct pid_namespace *pid = inode->i_sb->s_fs_info;
+	struct task_struct *task;
+	bool allowed;
+
+	/* ptrace permission hooks may block; retry outside RCU path walking. */
+	if (flags & IPERM_FLAG_RCU)
+		return -ECHILD;
+	task = get_proc_task(inode);
+	if (!task)
+		return -ESRCH;
+	allowed = has_pid_permissions(pid, task, 1);
+	put_task_struct(task);
+	if (!allowed)
+		return pid->hide_pid == 2 ? -ENOENT : -EPERM;
+	return generic_permission(inode, mask, flags, NULL);
+}
