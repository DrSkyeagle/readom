 				__pm_wakeup_event(usb_attach_ws, USB_ATTACH_HOLD_MS);
+#ifdef CONFIG_USB_GADGET_ARC
+				usbotg_wake_for_cable();
+#endif
 				regulator_enable(phyreg);
 				usbotg_force_bsession(true);
 			} else {
