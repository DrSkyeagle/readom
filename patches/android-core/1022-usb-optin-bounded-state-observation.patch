--- a/drivers/usb/gadget/arcotg_udc.c
+++ b/drivers/usb/gadget/arcotg_udc.c
@@ -83,6 +83,56 @@
 /* it is initialized in probe()  */
 static struct fsl_udc *udc_controller;
 
+/* Opt-in, bounded diagnostics. Sample software state and values already read
+ * by the driver; never wake the PHY or read an additional hardware register. */
+static bool pw3_diag;
+module_param(pw3_diag, bool, 0400);
+MODULE_PARM_DESC(pw3_diag, "Bounded PW3 USB software-state observations");
+static struct delayed_work pw3_diag_work;
+static unsigned int pw3_diag_sample;
+static atomic_t pw3_diag_irqs = ATOMIC_INIT(0);
+static atomic_t pw3_diag_delayed_irqs = ATOMIC_INIT(0);
+static atomic_t pw3_diag_resumes = ATOMIC_INIT(0);
+static u32 pw3_diag_run_otg, pw3_diag_irq_otg, pw3_diag_irq_src;
+
+static void pw3_diag_worker(struct work_struct *work)
+{
+    struct fsl_udc *udc = udc_controller;
+    struct fsl_usb2_platform_data *pdata;
+    unsigned long flags;
+    unsigned int stopped, suspended, lowpower, delay, pending;
+    unsigned int vbus, softconnect, state, speed, first;
+    (void)work;
+    if (!udc || !pw3_diag)
+        return;
+    pdata = udc->pdata;
+    ++pw3_diag_sample;
+    if (spin_trylock_irqsave(&udc->lock, flags)) {
+        stopped = udc->stopped;
+        suspended = udc->suspended;
+        lowpower = pdata->lowpower;
+        delay = pdata->irq_delay;
+        pending = pdata->wakeup_pdata->usb_wakeup_is_pending;
+        vbus = udc->vbus_active;
+        softconnect = udc->softconnect;
+        state = udc->usb_state;
+        speed = udc->gadget.speed;
+        first = udc->first_resume;
+        spin_unlock_irqrestore(&udc->lock, flags);
+        printk(KERN_INFO "pw3-usb-diag: n=%u stop=%u suspend=%u lp=%u delay=%u pending=%u vbus=%u soft=%u state=%u speed=%u first=%u irq=%d delayed_irq=%d resume=%d run_otg=%08x irq_otg=%08x irq_src=%08x\n",
+            pw3_diag_sample, stopped, suspended, lowpower, delay, pending,
+            vbus, softconnect, state, speed, first,
+            atomic_read(&pw3_diag_irqs), atomic_read(&pw3_diag_delayed_irqs),
+            atomic_read(&pw3_diag_resumes), pw3_diag_run_otg,
+            pw3_diag_irq_otg, pw3_diag_irq_src);
+    } else {
+        printk(KERN_INFO "pw3-usb-diag: n=%u state_lock_busy=1\n", pw3_diag_sample);
+    }
+    if (pw3_diag_sample < 24)
+        schedule_delayed_work(&pw3_diag_work, msecs_to_jiffies(10000));
+}
+
+
