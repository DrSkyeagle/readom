+#ifdef CONFIG_ANDROID_GID_NET_CAPABILITIES
+/*
+ * Android init assigns these reserved groups to the Wi-Fi daemons.  Use
+ * the supplied credentials, not current's groups: cap_capable can query
+ * another task.  A group in a child user namespace must not gain powers
+ * in the initial namespace, and explicit bounding-set drops still apply.
+ * SELinux capability and netlink checks remain in their existing callers.
+ */
+static bool android_gid_net_capable(const struct cred *cred,
+				   struct user_namespace *targ_ns, int cap)
+{
+	gid_t gid;
+
+	if (targ_ns != &init_user_ns || cred->user->user_ns != &init_user_ns)
+		return false;
+	switch (cap) {
+	case CAP_NET_RAW:
+		gid = AID_NET_RAW;
+		break;
+	case CAP_NET_ADMIN:
+		gid = AID_NET_ADMIN;
+		break;
+	default:
+		return false;
+	}
+	if (!cap_raised(cred->cap_bset, cap))
+		return false;
+	return cred->egid == gid || groups_search(cred->group_info, gid);
+}
+#endif
+
 int cap_netlink_send(struct sock *sk, struct sk_buff *skb)
 {
+#ifdef CONFIG_ANDROID_GID_NET_CAPABILITIES
+	const struct cred *cred = current_cred();
+
+	BUILD_BUG_ON(sizeof(struct netlink_skb_parms) > sizeof(skb->cb));
+	/* The skb payload/SCM ucred cannot supply supplementary groups. */
+	NETLINK_CB(skb).android_gid_net_caps = 0;
+	if (android_gid_net_capable(cred, &init_user_ns, CAP_NET_RAW))
+		NETLINK_CB(skb).android_gid_net_caps |= CAP_TO_MASK(CAP_NET_RAW);
+	if (android_gid_net_capable(cred, &init_user_ns, CAP_NET_ADMIN))
+		NETLINK_CB(skb).android_gid_net_caps |= CAP_TO_MASK(CAP_NET_ADMIN);
+#endif
 	return 0;
 }
 
 int cap_netlink_recv(struct sk_buff *skb, int cap)
 {
-	if (!cap_raised(current_cap(), cap))
-		return -EPERM;
-	return 0;
+	if (cap_raised(current_cap(), cap))
+		return 0;
+#ifdef CONFIG_ANDROID_GID_NET_CAPABILITIES
+	/* Only the sender-side hook can populate these two grant bits. */
+	if ((cap == CAP_NET_RAW || cap == CAP_NET_ADMIN) &&
+	    (NETLINK_CB(skb).android_gid_net_caps & CAP_TO_MASK(cap)))
+		return 0;
+#endif
+	return -EPERM;
 }
 EXPORT_SYMBOL(cap_netlink_recv);
 
