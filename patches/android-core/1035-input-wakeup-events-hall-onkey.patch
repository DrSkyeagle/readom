 #define HALL_EVENT_DELAY    3000
 #define HALL_EVENT_DEB      250
+/* How long the system stays awake after an event is reported, for user space
+ * (Android's EventHub) to read it before the next suspend. */
+#define HALL_WAKE_HOLD      500
 /* Hall Sensor States */
 #define STATE_OPENED        0
 #define STATE_CLOSED        1
@@ -75,6 +79,9 @@
 static int current_state = 0;		/* OPEN=0, CLOSE=1 */
 static int hall_enabled = HALL_CTRL_ENABLE;	/* Enable Hall control by default */
 static bool hall_irq_wake_enabled;
+/* The wakeup source: an edge, its debounce and its report are one wakeup event,
+ * so that the system cannot suspend before the lid state reaches user space. */
+static struct device *hall_dev;
 #ifdef CONFIG_WARIO_HALL_INPUT
 static struct input_dev *hall_input;
 #endif
@@ -392,9 +399,11 @@
 				 *	defer current close event when previous open event occured immiediately after close  
 				 */
 				schedule_delayed_work(&hall_close_event_work, msecs_to_jiffies(HALL_EVENT_DELAY));
+				pm_wakeup_event(hall_dev, HALL_EVENT_DELAY + HALL_WAKE_HOLD);
 			} else { 
 				/* Hall debounce on a normal (cover close) scenario */
 				schedule_delayed_work(&hall_close_event_work, msecs_to_jiffies(HALL_EVENT_DEB));
+				pm_wakeup_event(hall_dev, HALL_EVENT_DEB + HALL_WAKE_HOLD);
 			}
 			if (hall_dbg) 
 				printk(KERN_INFO "KERNEL: I hall:close event::current_state=%d\n",current_state);
