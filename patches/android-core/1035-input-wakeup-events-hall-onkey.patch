 			hall_report_lid(0);
+			pm_wakeup_event(hall_dev, HALL_WAKE_HOLD);
 			hall_close_delay = 1;
 			schedule_delayed_work(&hall_open_event_work, msecs_to_jiffies(HALL_EVENT_DELAY));
 		}
@@ -425,6 +435,8 @@
 
 static irqreturn_t hall_isr(int irq, void *dev_id)
 {
+	/* Until hall_detwq_handler has run and set the debounce's own time. */
+	pm_wakeup_event(hall_dev, HALL_WAKE_HOLD);
 	disable_irq_nosync(irq);
 	schedule_work(&hall_detwq);
 
@@ -510,6 +522,10 @@
 		goto fail_input;
 	}
 
+	/* Wakeup capable, its wakeup source in place before the IRQ can fire. */
+	hall_dev = &pdev->dev;
+	device_init_wakeup(hall_dev, true);
+
 	irq = pdata->hall_irq;
 	error = request_irq(irq, hall_isr, (IRQF_TRIGGER_RISING | IRQF_TRIGGER_FALLING | IRQF_EARLY_RESUME), 
 							HALL_DRIVER_NAME, pdata);
@@ -518,9 +534,6 @@
 		goto fail3;
 	} 
 
-	/* Configure wakeup capable */
-	device_set_wakeup_capable(&pdev->dev, true); 
-
 	error = hall_sysfs_register();
 	if (error)
 		goto fail_irq;
@@ -531,8 +544,9 @@
 
 fail_irq:
 	hall_stop_work(pdata);
-	device_set_wakeup_capable(&pdev->dev, false);
 fail3:
+	device_init_wakeup(&pdev->dev, false);
+	hall_dev = NULL;
 	misc_deregister(&hall_misc_device);
 fail_input:
 	hall_input_unregister();
@@ -552,7 +566,8 @@
 	hall_stop_work(pdata);
 	misc_deregister(&hall_misc_device);
 	hall_input_unregister();
-	device_set_wakeup_capable(&pdev->dev, false);
