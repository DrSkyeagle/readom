+static int ep_create_wakeup_source(struct epitem *epi)
+{
+	const char *name;
+	struct wakeup_source *ws;
+	unsigned long flags;
+
+	if (!epi->ep->ws) {
+		epi->ep->ws = wakeup_source_register("eventpoll");
+		if (!epi->ep->ws)
+			return -ENOMEM;
+	}
+
+	name = epi->ffd.file->f_path.dentry->d_name.name;
+	ws = wakeup_source_register(name);
+	if (!ws)
+		return -ENOMEM;
+
+	/* ep_modify/scan hold mtx; callbacks read ws under ep->lock. */
+	spin_lock_irqsave(&epi->ep->lock, flags);
+	epi->ws = ws;
+	if (ep_is_linked(&epi->rdllink))
+		__pm_stay_awake(ws);
+	spin_unlock_irqrestore(&epi->ep->lock, flags);
+	return 0;
+}
+
+static void ep_destroy_wakeup_source(struct epitem *epi)
+{
+	struct wakeup_source *ws;
+	unsigned long flags;
+
+	/* Wait for callbacks before unpublishing, then unregister unlocked. */
+	spin_lock_irqsave(&epi->ep->lock, flags);
+	ws = epi->ws;
+	epi->ws = NULL;
+	spin_unlock_irqrestore(&epi->ep->lock, flags);
+	ep_unregister_wakeup_source(ws);
+}
