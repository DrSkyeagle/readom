+/*
+ * PW3: from AOSP kernel/common deprecated/android-3.0 (563897de) with only the
+ * MTP and PTP functions; the others (ACM, RNDIS, mass storage, accessory, audio
+ * source) are left out (docs/design/usb-mtp.md). adb is the "ffs" function of
+ * deprecated/android-3.4 (40bb591c): FunctionFS inside this gadget, "adb" being
+ * an alias of it. Android 8.1's adbd speaks FunctionFS only, not android-3.0's
+ * f_adb (/dev/android_adb). Built as a module, g_android, like the UDC.
+ */
+
+/* #define DEBUG */
+/* #define VERBOSE_DEBUG */
+
+#include <linux/init.h>
+#include <linux/module.h>
+#include <linux/fs.h>
+
+#include <linux/delay.h>
+#include <linux/kernel.h>
+#include <linux/utsname.h>
+#include <linux/platform_device.h>
