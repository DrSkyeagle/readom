+/*
+ * Physical address of log_buf once it sits at log_goal_location, else 0.
+ * The next boot saves that memory as the previous boot's log
+ * (/proc/printkbuf). When the watchdog resets a hung system, text still in
+ * the CPU caches never reaches that memory, so every message is written
+ * back as it is stored, and so is the cleared buffer at boot.
+ */
+static phys_addr_t log_buf_phys;
+
+#ifdef CONFIG_ARM
+static void write_back(char *va, phys_addr_t pa, unsigned len)
+{
+	/* inner caches first, then the outer (L2) cache */
+	__cpuc_flush_dcache_area(va, len);
+	outer_clean_range(pa, pa + len);
+}
+
+static void log_buf_write_back(unsigned start, unsigned end)
+{
+	if (!log_buf_phys)
+		return;
+	if (end - start > (unsigned)log_buf_len)
+		start = end - log_buf_len;
+	while (start != end) {
+		unsigned idx = start & (log_buf_len - 1);
+		unsigned len = min(end - start, (unsigned)log_buf_len - idx);
 
+		write_back(log_buf + idx, log_buf_phys + idx, len);
+		start += len;
+	}
+}
+#endif
