Subject: [PATCH] binder: keep buffer metadata outside the userspace mapping

Based on Android msm 3df8baeedccb6607c08a28533b47b81bbe339f39 and Linux
74310e06be4d74dcf67cd108366710dee5c576d5, with the lifetime/accounting fixes:
  957ccc2bc8f9ebfe8b19112cdc6c2bb20fd7bcf8 (open without mmap)
  ae65c8510f3319dfb2114cc48d476b81232e27b3 (NULL next in debug output)
  cfd0d84ba28c18b531648c9d4a35ecca89ad9901 (empty async quota return)

Retain msm's first zero payload page for the mapping lifetime. Preserve
per-async metadata charging, pad before admission, and avoid overflowing
the admission sum. Translate PAGE_ALIGNED to a Linux 3.0-compatible mask.
The 32-bit Binder UAPI and SG/PTR/FDA transaction translation are unchanged.

--- a/drivers/staging/android/binder.c
+++ b/drivers/staging/android/binder.c
@@ -304,7 +304,7 @@
 	size_t data_size;
 	size_t offsets_size;
 	size_t extra_buffers_size;
-	uint8_t data[0];
+	void *data;
 };
 
 enum binder_deferred_state {
@@ -565,14 +565,23 @@
 	binder_user_error("%d RLIMIT_NICE not set\n", current->pid);
 }
 
+static struct binder_buffer *binder_buffer_next(struct binder_buffer *buffer)
+{
+	return list_entry(buffer->entry.next, struct binder_buffer, entry);
+}
+
+static struct binder_buffer *binder_buffer_prev(struct binder_buffer *buffer)
+{
+	return list_entry(buffer->entry.prev, struct binder_buffer, entry);
+}
+
 static size_t binder_buffer_size(struct binder_proc *proc,
 				 struct binder_buffer *buffer)
 {
 	if (list_is_last(&buffer->entry, &proc->buffers))
-		return proc->buffer + proc->buffer_size - (void *)buffer->data;
-	else
-		return (size_t)list_entry(buffer->entry.next,
-			struct binder_buffer, entry) - (size_t)buffer->data;
+		return (u8 *)proc->buffer +
+			proc->buffer_size - (u8 *)buffer->data;
+	return (u8 *)binder_buffer_next(buffer)->data - (u8 *)buffer->data;
 }
 
 static void binder_insert_free_buffer(struct binder_proc *proc,
@@ -622,9 +631,9 @@
