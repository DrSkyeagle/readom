+/*
+ * D+ is pulled up (the controller's run bit) when the gadget driver asks for it
+ * (softconnect: usb_gadget_connect/disconnect, so Android's composite gadget
+ * can hold it back until its functions are ready) and the cable's session
+ * allows it (dp_allowed: set by dp_pullup() once VBUS is seen, see
+ * imx_usb_vbus_connect(), cleared when VBUS goes).
+ */
 static int can_pullup(struct fsl_udc *udc)
 {
-	return udc->driver && udc->softconnect && udc->vbus_active;
+	return udc->driver && udc->softconnect && udc->vbus_active &&
+		udc->dp_allowed;
 }
 
+/*
+ * Apply can_pullup() to the run bit. Called with udc->lock held or interrupts
+ * off. A stopped controller has its clock off (see nuke()): an access then
+ * stalls the bus until the watchdog resets the system (Test V44, adbd ready
+ * with no cable). Its run bit is cleared when it stops, and set again here
+ * for the next session.
+ */
+static void fsl_apply_pullup(struct fsl_udc *udc)
+{
+	u32 usbcmd;
+
+	if (udc->stopped)
+		return;
+	usbcmd = fsl_readl(&dr_regs->usbcmd);
+	if (can_pullup(udc))
+		usbcmd |= USB_CMD_RUN_STOP;
+	else
+		usbcmd &= ~USB_CMD_RUN_STOP;
+	fsl_writel(usbcmd, &dr_regs->usbcmd);
+}
