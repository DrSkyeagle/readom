+
+static void hall_stop_work(struct hall_platform_data *pdata)
+{
+	/*
+	 * Stop the producer before draining work. The detwq handler can
+	 * re-enable the IRQ it disabled, so keep our extra disable reference
+	 * until free_irq(). No work may outlive the misc or input device.
+	 */
+	disable_irq(pdata->hall_irq);
+	cancel_work_sync(&hall_detwq);
+	cancel_delayed_work_sync(&hall_init_work);
+	cancel_delayed_work_sync(&hall_open_event_work);
+	cancel_delayed_work_sync(&hall_close_event_work);
+	if (hall_irq_wake_enabled) {
+		disable_irq_wake(pdata->hall_irq);
+		hall_irq_wake_enabled = false;
+	}
+	free_irq(pdata->hall_irq, pdata);
 }
 
