 static int hall_close_delay = 0;	/* delay to avoid multiple transitions within short duration */
 static int current_state = 0;		/* OPEN=0, CLOSE=1 */
 static int hall_enabled = HALL_CTRL_ENABLE;	/* Enable Hall control by default */
+static bool hall_irq_wake_enabled;
+#ifdef CONFIG_WARIO_HALL_INPUT
+static struct input_dev *hall_input;
+#endif
+
+static void hall_report_lid(int closed)
+{
+#ifdef CONFIG_WARIO_HALL_INPUT
+	if (hall_input) {
+		input_report_switch(hall_input, SW_LID, !!closed);
+		input_sync(hall_input);
+	}
+#endif
+}
+
+static int hall_input_register(struct platform_device *pdev)
+{
+#ifdef CONFIG_WARIO_HALL_INPUT
+	struct input_dev *input;
+	int error;
+
+	input = input_allocate_device();
+	if (!input)
+		return -ENOMEM;
+
+	input->name = HALL_DRIVER_NAME;
+	input->phys = HALL_DRIVER_NAME "/input0";
+	input->id.bustype = BUS_HOST;
+	input->dev.parent = &pdev->dev;
+	input_set_capability(input, EV_SW, SW_LID);
+	/* Seed EVIOCGSW before registration, including boot with cover shut. */
+	input_report_switch(input, SW_LID,
+			hall_enabled && gpio_hallsensor_detect());
+	error = input_register_device(input);
+	if (error) {
+		input_free_device(input);
+		return error;
+	}
+	hall_input = input;
+#endif
+	return 0;
+}
+
+static void hall_input_unregister(void)
+{
+#ifdef CONFIG_WARIO_HALL_INPUT
+	if (hall_input) {
+		input_unregister_device(hall_input);
+		hall_input = NULL;
+	}
+#endif
+}
 
