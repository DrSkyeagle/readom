--- a/drivers/usb/gadget/arcotg_udc.c
+++ b/drivers/usb/gadget/arcotg_udc.c
@@ -86,6 +86,10 @@
 /* Opt-in, bounded diagnostics. Sample software state and values already read
  * by the driver; never wake the PHY or read an additional hardware register. */
 static bool pw3_diag;
+static bool pw3_keep_awake;
+static bool pw3_clock_held;
+module_param(pw3_keep_awake, bool, 0400);
+MODULE_PARM_DESC(pw3_keep_awake, "Explicit debug-only active USB PHY and retained clock reference");
 module_param(pw3_diag, bool, 0400);
 MODULE_PARM_DESC(pw3_diag, "Bounded PW3 USB software-state observations");
 static struct delayed_work pw3_diag_work;
@@ -119,9 +123,10 @@
         speed = udc->gadget.speed;
         first = udc->first_resume;
         spin_unlock_irqrestore(&udc->lock, flags);
-        printk(KERN_INFO "pw3-usb-diag: n=%u stop=%u suspend=%u lp=%u delay=%u pending=%u vbus=%u soft=%u state=%u speed=%u first=%u irq=%d delayed_irq=%d resume=%d run_otg=%08x irq_otg=%08x irq_src=%08x\n",
+        printk(KERN_INFO "pw3-usb-diag: n=%u stop=%u suspend=%u lp=%u delay=%u pending=%u vbus=%u soft=%u state=%u speed=%u first=%u awake=%u clock_hold=%u irq=%d delayed_irq=%d resume=%d run_otg=%08x irq_otg=%08x irq_src=%08x\n",
             pw3_diag_sample, stopped, suspended, lowpower, delay, pending,
             vbus, softconnect, state, speed, first,
+            (unsigned int)pw3_keep_awake, (unsigned int)pw3_clock_held,
             atomic_read(&pw3_diag_irqs), atomic_read(&pw3_diag_delayed_irqs),
             atomic_read(&pw3_diag_resumes), pw3_diag_run_otg,
             pw3_diag_irq_otg, pw3_diag_irq_src);
@@ -401,6 +406,10 @@
 	struct fsl_usb2_platform_data *pdata = udc->pdata;
 	u32 portsc;
 	unsigned long flags;
+	/* Held diagnostic boots do not depend on the failed low-power wakeup path.
+	 * The default follows the original request without changing policy. */
+	if (pw3_keep_awake)
+		enable = false;
 	spin_lock_irqsave(&pdata->lock, flags);
 
 	if (pdata && pdata->phy_lowpower_suspend) {
@@ -3155,6 +3164,8 @@
 	unsigned int i;
 	u32 dccparams;
 
+	if (pw3_keep_awake && !pw3_diag)
+		return -EINVAL;
 	udc_controller = kzalloc(sizeof(struct fsl_udc), GFP_KERNEL);
 	if (udc_controller == NULL) {
 		ERR("malloc udc failed\n");
@@ -3351,6 +3362,12 @@
 	udc_controller->charger.enable = false;
 #endif
 
+	/* No failure exits remain below this point. Retain one owned clock
+	 * reference until removal; all pre-existing clock pairs stay intact. */
+	if (pw3_keep_awake) {
+		dr_clk_gate(true);
+		pw3_clock_held = true;
+	}
 	if (pw3_diag)
 		schedule_delayed_work(&pw3_diag_work, msecs_to_jiffies(10000));
 	return 0;
@@ -3395,6 +3412,10 @@
 	dr_discharge_line(pdata, true);
 
 	dr_clk_gate(false);
+	if (pw3_clock_held) {
+		dr_clk_gate(false);
+		pw3_clock_held = false;
+	}
 	/* DR has been stopped in usb_gadget_unregister_driver() */
 	remove_proc_file();
 
