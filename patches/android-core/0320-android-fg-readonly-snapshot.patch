+#ifdef CONFIG_LAB126_ANDROID_POWER_SUPPLY_ABI
+/*
+ * FGS1 wire format, 32 bytes, all multibyte fields little-endian:
+ * 0..3 magic; 4 init_complete; 5 cached restore_pending; 6 hardware POR;
+ * 7 battery_id_valid; 8..11 battery_error; 12..31 ten learned u16 slots.
+ * Only slots 1..7 are valid, as in the stock learned-state workaround.
+ * Slots 0, 8 and 9 are explicitly zero, not stale system_battlearn data.
+ */
+static int max77696_gauge_android_snapshot(struct max77696_gauge *me, u8 *buf)
+{
+	u16 status_before, status_after, raw;
+	u32 errors;
+	int id, rc;
+
+	__lock(me);
+	if (!me->init_complete) {
+		rc = -EAGAIN;
+		goto out;
+	}
+	rc = max77696_gauge_reg_read_word(me, STATUS, &status_before);
+	if (rc)
+		goto out;
+	memset(buf, 0, 32);
+	for (id = 1; id < (GAUGE_LEARNED_NR_REGS - 2); id++) {
+		rc = max77696_bulk_read(me->i2c,
+				max77696_gauge_learned_regs[id], (u8 *)&raw, 2);
+		if (rc)
+			goto out;
+		raw = __le16_to_cpu(raw);
+		buf[12 + id * 2] = raw & 0xff;
+		buf[13 + id * 2] = raw >> 8;
+	}
+	rc = max77696_gauge_reg_read_word(me, STATUS, &status_after);
+	if (rc)
+		goto out;
+	if ((status_before ^ status_after) & FG_STATUS_POR) {
+		rc = -EAGAIN;
+		goto out;
+	}
+	memcpy(buf, "FGS1", 4);
+	buf[4] = 1;
+	/* Hardware POR has already been cleared by init_config(). */
+	buf[5] = !!me->por_bit_set;
+	buf[6] = !!(status_after & FG_STATUS_POR);
+	buf[7] = !!wario_battery_valid;
+	errors = (u32)wario_battery_error_flags;
+	buf[8] = errors & 0xff;
+	buf[9] = (errors >> 8) & 0xff;
+	buf[10] = (errors >> 16) & 0xff;
+	buf[11] = errors >> 24;
+	rc = 32;
+out:
+	__unlock(me);
+	return rc;
+}
+#endif
 
