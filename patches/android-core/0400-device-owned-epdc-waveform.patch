+/* Android PW3 policy. Included by mxc_epdc_fb.c after the Lab126 helpers. */
+#ifdef CONFIG_LAB126_ANDROID_EPDC
+static u64 android_wf_le64(const u8 *p)
+{
+	u64 value = 0;
+	int i;
+	for (i = 0; i < 8; ++i)
+		value |= (u64)p[i] << (8 * i);
+	return value;
+}
+
+/* Only versions with an explicit production table in this source are allowed. */
+static int android_wf_layout(u8 *data, size_t length, size_t *vc_offset,
+			     size_t *vc_length)
+{
+	struct waveform_data_header *h = (struct waveform_data_header *)data;
+	size_t off, bytes, modes, temps, entries, i, j;
+	u64 start, end;
+	u8 *payload;
+	*vc_offset = *vc_length = 0;
+	if (sizeof(*h) != WFM_HDR_SIZE || length < WFM_HDR_SIZE ||
+	    !android_wf_header_valid(h) || h->file_length != length)
+		return -EINVAL;
+	if (eink_get_computed_waveform_checksum(data) != h->checksum)
+		return -EBADMSG;
+	modes = h->mc + 1;
+	temps = h->trc + 1;
+	off = WFM_HDR_SIZE + temps + 1;
+	if (off >= length || modes < 3 || temps < 2 || h->advanced_wfm_flags > 3)
+		return -EINVAL;
+	/* Preserve the original TRT bytes and its existing temperature lookup ABI. */
+	bytes = length - off;
+	payload = data + off;
+	entries = modes;
+	if (h->advanced_wfm_flags == 1 || h->advanced_wfm_flags == 3)
+		entries = modes + 2;
+	if (entries > bytes / 8)
+		return -EINVAL;
+	/* The EPDC-owned waveform encoding is copied unchanged and checked against
+	 * every physical panel byte. Bound only the offsets dereferenced by this CPU.
+	 */
+	if (h->advanced_wfm_flags == 1 || h->advanced_wfm_flags == 3) {
+		start = android_wf_le64(payload + modes * 8);
+		end = android_wf_le64(payload + (modes + 1) * 8);
+		if (start < entries * 8 || start >= end || end > bytes ||
+		    end - start < modes * temps * sizeof(struct epd_vc_data))
+			return -EINVAL;
+		for (i = 0; i < modes * temps; ++i) {
+			u8 sum = 0;
+			const u8 *record = payload + start + i * sizeof(struct epd_vc_data);
+			for (j = 0; j + 1 < sizeof(struct epd_vc_data); ++j)
+				sum += record[j];
+			if (sum != record[sizeof(struct epd_vc_data) - 1])
+				return -EBADMSG;
+		}
+		*vc_offset = off + (size_t)start;
+		*vc_length = (size_t)(end - start);
+	}
+	return 0;
+}
+
+/* Compare all bytes with this physical panel, before any EPDC waveform DMA. */
+static int android_wf_matches_panel(const u8 *data, size_t length)
+{
+	struct panel_info *panel;
+	u8 *chunk;
+	size_t off, count;
+	int ret;
+	if (!panel_flash_present() || override_panel_settings)
+		return -ENODEV;
+	ret = panel_get_info(&panel, true);
+	if (ret)
+		return ret;
+	if (length > panel->addrs->waveform_len)
+		return -EINVAL;
+	chunk = kmalloc(1024, GFP_KERNEL);
+	if (!chunk)
+		return -ENOMEM;
+	for (off = 0; off < length; off += count) {
+		count = min((size_t)1024, length - off);
+		ret = panel_read_from_flash(panel->addrs->waveform_addr + off, chunk, count);
+		if (ret) {
+			ret = -EIO;
+			break;
+		}
+		if (memcmp(data + off, chunk, count)) {
+			ret = -EXDEV;
+			break;
+		}
+	}
+	kfree(chunk);
+	return ret;
+}
+#endif
