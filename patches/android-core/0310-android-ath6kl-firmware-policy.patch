+++ b/compat-wireless/drivers/net/wireless/ath/ath6kl/init.c
@@ -29,10 +29,53 @@
 #ifdef CONFIG_LAB126
 #include <mach/boardid.h>
 #define BOARD_DATA_FILE_NAME_SIZE  256
+#ifdef CONFIG_LAB126_ANDROID_ATH6KL_FIRMWARE
+/* No guessed calibration default in the Android image. */
+char board_data_file[BOARD_DATA_FILE_NAME_SIZE];
+#else
 char board_data_file[BOARD_DATA_FILE_NAME_SIZE] = AR6003_REV3_BOARD_DATA_FILE;
+#endif
+#ifdef CONFIG_LAB126_ANDROID_ATH6KL_FIRMWARE
+module_param_string(board_data_file, board_data_file, BOARD_DATA_FILE_NAME_SIZE, 0444);
+#else
 module_param_string(board_data_file, board_data_file, BOARD_DATA_FILE_NAME_SIZE, 0644);
+#endif
 
 #endif /* CONFIG_LAB126 */
+
+#ifdef CONFIG_LAB126_ANDROID_ATH6KL_FIRMWARE
+int ath6kl_android_validate_board_data(void)
+{
+	const char *p = board_data_file;
+	const char *component = p;
+
+	if (strncmp(p, "ath6k/", 6))
+		goto invalid;
+	for (;;) {
+		char c = *p;
+
+		if (!c || c == '/') {
+			size_t len = p - component;
+
+			if (!len || (len == 1 && component[0] == '.') ||
+			    (len == 2 && component[0] == '.' && component[1] == '.'))
+				goto invalid;
+			if (!c)
+				return 0;
+			component = p + 1;
+		} else if (!((c >= 'a' && c <= 'z') ||
+			     (c >= 'A' && c <= 'Z') ||
+			     (c >= '0' && c <= '9') ||
+			     c == '_' || c == '-' || c == '.')) {
+			goto invalid;
+		}
+		p++;
+	}
+invalid:
+	ath6kl_err("Android requires an explicit relative ath6k board_data_file\n");
+	return -EINVAL;
+}
+#endif
 
