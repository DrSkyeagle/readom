--- /dev/null
+++ b/drivers/hwmon/max77696-display-temperature.h
@@ -0,0 +1,67 @@
+/* Included by max77696-adc.c; no I/O occurs in these cache/status operations. */
+#ifdef CONFIG_LAB126_ANDROID_EPDC
+static DEFINE_SPINLOCK(display_temp_lock);
+static bool display_temp_valid;
+static int display_temp_error = -EAGAIN;
+static u64 display_temp_last_success;
+
+static void max77696_display_temp_publish(int error, int celsius)
+{
+	unsigned long flags;
+	spin_lock_irqsave(&display_temp_lock, flags);
+	display_temp_error = error > 0 ? -EIO : error;
+	if (!error) {
+		display_temp_c = celsius;
+		display_temp_valid = true;
+		display_temp_last_success = get_jiffies_64();
+	}
+	spin_unlock_irqrestore(&display_temp_lock, flags);
+}
+
+static void max77696_display_temp_invalidate(int error)
+{
+	unsigned long flags;
+	spin_lock_irqsave(&display_temp_lock, flags);
+	display_temp_valid = false;
+	display_temp_error = error;
+	display_temp_last_success = 0;
+	spin_unlock_irqrestore(&display_temp_lock, flags);
+}
+
+/* Success means at least one completed sample, not that the last attempt worked.
+ * On a later failed attempt the previously measured temperature is retained.
+ */
+int max77696_adc_get_display_temp(int *celsius)
+{
+	unsigned long flags;
+	int ret;
+	if (!celsius)
+		return -EINVAL;
+	spin_lock_irqsave(&display_temp_lock, flags);
+	ret = display_temp_valid ? 0 : (display_temp_error ? display_temp_error : -EAGAIN);
+	if (!ret)
+		*celsius = display_temp_c;
+	spin_unlock_irqrestore(&display_temp_lock, flags);
+	return ret;
+}
+EXPORT_SYMBOL(max77696_adc_get_display_temp);
+
+static ssize_t max77696_adc_display_temp_status_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	unsigned long flags;
+	bool valid;
+	int error;
+	u64 age;
+	spin_lock_irqsave(&display_temp_lock, flags);
+	valid = display_temp_valid;
+	error = display_temp_error;
+	age = valid ? get_jiffies_64() - display_temp_last_success : 0;
+	spin_unlock_irqrestore(&display_temp_lock, flags);
+	/* This is jiffies-based elapsed time, not a wall-clock freshness guarantee. */
+	return scnprintf(buf, PAGE_SIZE, "valid=%u last_error=%d age_ms=%llu\n",
+		valid ? 1 : 0, error, (unsigned long long)div_u64(age * 1000, HZ));
+}
+static DEVICE_ATTR(display_temp_status, S_IRUGO,
+		max77696_adc_display_temp_status_show, NULL);
+#endif
