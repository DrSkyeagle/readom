+#ifdef CONFIG_LAB126_ANDROID_EPDC
+static int mxc_epdc_android_startup_temperature(int *temperature)
+{
+	int attempt, ret;
+	/* Allow the already queued first sample to run; do not start a new ADC read. */
+	for (attempt = 0; attempt < 20; ++attempt) {
+		ret = max77696_adc_get_display_temp(temperature);
+		if (ret != -EAGAIN)
+			return ret;
+		msleep(100);
+	}
+	return max77696_adc_get_display_temp(temperature);
+}
+
+static int mxc_epdc_android_resolve_temperature(struct mxcfb_update_data *update)
+{
+	int temperature, ret;
+	if (update->temp != TEMP_USE_AUTO)
+		return 0;
+	ret = max77696_adc_get_display_temp(&temperature);
+	if (ret)
+		return ret;
+	/* Freeze one successful measurement for the entire update, including splits. */
+	update->temp = temperature;
+	return 0;
+}
