  * function to attach either it or all tasks in its threadgroup. Will take
  * cgroup_mutex; may take task_lock of task.
  */
+/* All controllers in a hierarchy must explicitly permit delegated attach.
+ * Empty named hierarchies retain the original root/same-uid restriction.
+ * Called with cgroup_mutex and rcu_read_lock held.
+ */
+static int cgroup_allow_attach(struct cgroup *cgrp, struct task_struct *tsk)
+{
+	struct cgroup_subsys *ss;
+	bool checked = false;
+	int ret;
+
+	for_each_subsys(cgrp->root, ss) {
+		if (!ss->allow_attach)
+			return -EACCES;
+		ret = ss->allow_attach(cgrp, tsk);
+		if (ret)
+			return ret;
+		checked = true;
+	}
+	return checked ? 0 : -EACCES;
+}
