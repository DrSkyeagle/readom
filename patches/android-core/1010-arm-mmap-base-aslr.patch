From: PW3 Android port
Subject: [PATCH] ARM: expose bounded mmap ASLR and randomize base per exec

Adapt the mmap_rnd_bits interface from Linux commits
d07e22597d1d355829b7b18ac19afa912cf758d1 and
e0c25d958f78acfd5c97df5776eeba3e0684101b (Daniel Cashman).
Retain the ARM 3.0 bottom-up VMA/cache-colour allocator. The optional
ARM_MMAP_BASE_RANDOMIZATION selects one randomized base at exec instead
of adding a large random gap on every mapping. All hole-search restarts
use that base. The stock configuration keeps its previous 8-bit mapping
behavior; no dummy sysctl or Android init security-check bypass is used.

--- a/arch/Kconfig
+++ b/arch/Kconfig
@@ -203,3 +203,20 @@
 	  See Documentation/prctl/seccomp_filter.txt for details.
 
 source "kernel/gcov/Kconfig"
+
+# From upstream d07e22597d1d; no compat sysctl on this ARM32-only port.
+config HAVE_ARCH_MMAP_RND_BITS
+	bool
+
+config ARCH_MMAP_RND_BITS_MIN
+	int
+
+config ARCH_MMAP_RND_BITS_MAX
+	int
+
+config ARCH_MMAP_RND_BITS
+	int "Number of bits for mmap base ASLR" if EXPERT
+	range ARCH_MMAP_RND_BITS_MIN ARCH_MMAP_RND_BITS_MAX
+	default ARCH_MMAP_RND_BITS_MIN
+	depends on HAVE_ARCH_MMAP_RND_BITS
+
--- a/arch/arm/Kconfig
+++ b/arch/arm/Kconfig
@@ -38,6 +38,25 @@
 	  Europe.  There is an ARM Linux project with a web page at
 	  <http://www.arm.linux.org.uk/>.
 
+
+config ARM_MMAP_BASE_RANDOMIZATION
+	bool "Configurable once-per-exec ARM mmap base randomization"
+	depends on MMU
+	select HAVE_ARCH_MMAP_RND_BITS
+	default n
+	help
+	  Enable the upstream mmap_rnd_bits sysctl with ARM address-space bounds.
+	  Randomize the bottom-up base once per exec, retaining this kernel's
+	  allocator and cache-alignment rules. Disabled preserves the stock ABI.
+
+config ARCH_MMAP_RND_BITS_MIN
+	default 8
+
+config ARCH_MMAP_RND_BITS_MAX
+	default 14 if PAGE_OFFSET=0x40000000
+	default 15 if PAGE_OFFSET=0x80000000
+	default 16
+
 config HAVE_PWM
 	bool
 
--- a/arch/arm/include/asm/processor.h
+++ b/arch/arm/include/asm/processor.h
@@ -22,6 +22,10 @@
 #include <asm/hw_breakpoint.h>
 #include <asm/ptrace.h>
 #include <asm/types.h>
+
+#ifdef CONFIG_ARM_MMAP_BASE_RANDOMIZATION
+#define HAVE_ARCH_PICK_MMAP_LAYOUT
+#endif
 
 #ifdef __KERNEL__
 #define STACK_TOP	((current->personality & ADDR_LIMIT_32BIT) ? \
--- a/include/linux/mm.h
+++ b/include/linux/mm.h
@@ -35,6 +35,12 @@
 extern int sysctl_legacy_va_layout;
 #else
 #define sysctl_legacy_va_layout 0
+#endif
+
+#ifdef CONFIG_HAVE_ARCH_MMAP_RND_BITS
+extern const int mmap_rnd_bits_min;
+extern const int mmap_rnd_bits_max;
+extern int mmap_rnd_bits __read_mostly;
 #endif
 
 #include <asm/page.h>
--- a/mm/mmap.c
+++ b/mm/mmap.c
@@ -44,6 +44,12 @@
 
 #ifndef arch_rebalance_pgtables
 #define arch_rebalance_pgtables(addr, len)		(addr)
+#endif
+
+#ifdef CONFIG_HAVE_ARCH_MMAP_RND_BITS
+const int mmap_rnd_bits_min = CONFIG_ARCH_MMAP_RND_BITS_MIN;
+const int mmap_rnd_bits_max = CONFIG_ARCH_MMAP_RND_BITS_MAX;
+int mmap_rnd_bits __read_mostly = CONFIG_ARCH_MMAP_RND_BITS;
 #endif
 
 static void unmap_region(struct mm_struct *mm,
--- a/kernel/sysctl.c
+++ b/kernel/sysctl.c
@@ -1285,6 +1285,17 @@
 		.proc_handler	= proc_dointvec_jiffies,
 	},
 #endif
+#ifdef CONFIG_HAVE_ARCH_MMAP_RND_BITS
+	{
+		.procname	= "mmap_rnd_bits",
+		.data		= &mmap_rnd_bits,
+		.maxlen		= sizeof(mmap_rnd_bits),
+		.mode		= 0600,
+		.proc_handler	= proc_dointvec_minmax,
+		.extra1		= (void *)&mmap_rnd_bits_min,
+		.extra2		= (void *)&mmap_rnd_bits_max,
+	},
+#endif
 #ifdef CONFIG_MMU
 	{
 		.procname	= "mmap_min_addr",
--- a/arch/arm/mm/mmap.c
+++ b/arch/arm/mm/mmap.c
@@ -32,6 +32,11 @@
 	struct mm_struct *mm = current->mm;
 	struct vm_area_struct *vma;
 	unsigned long start_addr;
+#ifdef CONFIG_ARM_MMAP_BASE_RANDOMIZATION
+	const unsigned long mmap_base = mm->mmap_base;
+#else
+	const unsigned long mmap_base = TASK_UNMAPPED_BASE;
+#endif
 #if defined(CONFIG_CPU_V6) || defined(CONFIG_CPU_V6K)
 	unsigned int cache_type;
 	int do_align = 0, aliasing = 0;
@@ -77,15 +82,17 @@
 			return addr;
 	}
 	if (len > mm->cached_hole_size) {
-	        start_addr = addr = mm->free_area_cache;
+	        start_addr = addr = max(mm->free_area_cache, mmap_base);
 	} else {
-	        start_addr = addr = TASK_UNMAPPED_BASE;
+	        start_addr = addr = mmap_base;
 	        mm->cached_hole_size = 0;
 	}
+#ifndef CONFIG_ARM_MMAP_BASE_RANDOMIZATION
 	/* 8 bits of randomness in 20 address space bits */
 	if ((current->flags & PF_RANDOMIZE) &&
 	    !(current->personality & ADDR_NO_RANDOMIZE))
 		addr += (get_random_int() % (1 << 8)) << PAGE_SHIFT;
+#endif
 
 full_search:
 	if (do_align)
@@ -100,8 +107,8 @@
 			 * Start a new search - just in case we missed
 			 * some holes.
 			 */
-			if (start_addr != TASK_UNMAPPED_BASE) {
-				start_addr = addr = TASK_UNMAPPED_BASE;
+			if (start_addr != mmap_base) {
+				start_addr = addr = mmap_base;
 				mm->cached_hole_size = 0;
 				goto full_search;
 			}
@@ -121,6 +128,28 @@
 			addr = COLOUR_ALIGN(addr, pgoff);
 	}
 }
+
+
+#ifdef CONFIG_ARM_MMAP_BASE_RANDOMIZATION
+/* Upstream e0c25d958f78 supplies the ARM mask/bounds. Keep the 3.0
+ * bottom-up allocator, but choose its base once per exec. Adding a new
+ * 16-bit gap on every mmap would needlessly fragment the address space. */
+void arch_pick_mmap_layout(struct mm_struct *mm)
+{
+	unsigned long random_factor = 0;
+
+	if ((current->flags & PF_RANDOMIZE) &&
+	    !(current->personality & ADDR_NO_RANDOMIZE))
+		random_factor = ((unsigned long)get_random_int() &
+			((1UL << mmap_rnd_bits) - 1)) << PAGE_SHIFT;
+
+	mm->mmap_base = TASK_UNMAPPED_BASE + random_factor;
+	mm->free_area_cache = mm->mmap_base;
+	mm->cached_hole_size = 0;
+	mm->get_unmapped_area = arch_get_unmapped_area;
+	mm->unmap_area = arch_unmap_area;
+}
+#endif
 
 
