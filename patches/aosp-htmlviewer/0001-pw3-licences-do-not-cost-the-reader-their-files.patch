+    /**
+     * Whether this file is on a volume that READ_EXTERNAL_STORAGE governs.
+     *
+     * PW3: AOSP asked for that permission for every file: URI, and the
+     * licences Settings shows are file:///system/etc/NOTICE.html.gz -- a file
+     * on the read-only system image that every app may read. The reader was
+     * asked for their photos, media and files to see an open source licence,
+     * and refusing closed the page, so the licences could not be read at all
+     * without it. getStorageVolume returns null for a path that is on no
+     * shared volume, which is the question this check means to ask.
+     */
+    private boolean isOnSharedStorage(Uri uri) {
+        if (!"file".equals(uri.getScheme()) || uri.getPath() == null) {
+            return false;
+        }
+        final StorageManager storage = getSystemService(StorageManager.class);
+        return storage != null && storage.getStorageVolume(new File(uri.getPath())) != null;
+    }
+
