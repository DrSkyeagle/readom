# Append AFTER the parent VExpress override which currently sets NETDEVICES=n.
# Also include the reviewed Android81 netd config and its 5 network patches.
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_DUMMY=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_PROC_FS=y
CONFIG_SYSCTL=y
CONFIG_TMPFS=y
# CONFIG_MODULES is not set
# No physical NIC, tun, veth, wireless, external network, or block device needed.
