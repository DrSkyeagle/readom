<!-- PW3: FallbackHome shows this when the user is still not unlocked 2 s after it came up,
     at every start (about 4 s on Test V45). AOSP's dims the screen by half and turns an
     indeterminate progress bar; on the panel that is a full-screen grey with white text,
     then a full white again (docs/design/eink-ui.md, rules 1 and 5: white ground, black
     text, no translucency or animation). Here the text alone, black on the white window. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:textSize="20sp"
        android:textColor="@android:color/black"
        android:text="@*android:string/android_start_title"/>

</FrameLayout>
