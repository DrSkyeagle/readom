# cfg80211 must already be loaded by the verified private-asset init fragment.
# wificond's board hook asks that fragment to load/unload ath6kl_sdio on demand.
service wpa_supplicant /vendor/bin/hw/wpa_supplicant -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf -O/data/misc/wifi/sockets -e/data/misc/wifi/entropy.bin -g@android:wpa_wlan0
    class main
    user wifi
    group wifi inet net_raw net_admin
    socket wpa_wlan0 dgram 0660 wifi wifi
    disabled
    oneshot
