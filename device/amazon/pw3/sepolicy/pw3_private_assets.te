# Private per-device calibration and waveform assets are read by ueventd only.
type pw3_private_firmware_file, file_type;
allow ueventd pw3_private_firmware_file:dir r_dir_perms;
allow ueventd pw3_private_firmware_file:file r_file_perms;
neverallow { appdomain shell } pw3_private_firmware_file:file { open read write execute };
