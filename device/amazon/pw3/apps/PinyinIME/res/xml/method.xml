<!-- The attributes in this XML file provide configuration information -->
<!-- for the Search Manager. -->

<!-- PW3: the subtype is this port's. Without one the framework cannot enable
     this input method by itself: getDefaultEnabledImes() asks every system IME
     for a keyboard subtype matching the system locale
     (InputMethodUtils.getMinimumKeyboardSetWithSystemLocale), an IME with no
     subtypes answers no to all six rounds, and this is the only IME on the
     device since LatinIME was dropped. A first boot on a data image the
     installer has just made therefore came up with no keyboard at all, and
     with no keyboard there is no way to type a Wi-Fi password, which is the
     step everything else waits on ("完全没有预装输入法", user, 2026-10-20).

     zh_CN, mode keyboard, ASCII capable: the keyboard types pinyin with the
     Latin letters and has an English mode of its own (InputModeSwitcher), so
     it is the one keyboard this device needs in either language. -->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
        android:settingsActivity="com.android.inputmethod.pinyin.SettingsActivity"
        android:isDefault="@bool/im_is_default">
    <subtype android:label="@string/ime_name"
            android:imeSubtypeLocale="zh_CN"
            android:imeSubtypeMode="keyboard"
            android:isAsciiCapable="true" />
</input-method>
