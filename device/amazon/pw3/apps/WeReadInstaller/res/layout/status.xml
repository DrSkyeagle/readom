<?xml version="1.0" encoding="utf-8"?>
<!-- What the home screen's WeRead entry opens: where the installation has got
     to, and the one thing to do about it. White page, black text, outlined
     button, no shadow and no animation (docs/design/eink-ui.md). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="32dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#000000"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textColor="#000000"
        android:textSize="18sp"
        android:lineSpacingMultiplier="1.3" />

    <TextView
        android:id="@+id/detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#000000"
        android:textSize="15sp"
        android:lineSpacingMultiplier="1.3" />

    <!-- 56dp high and 8dp clear of the text above: a target this far from the
         edge needs 48dp, and this one is the only thing to press. -->
    <Button
        android:id="@+id/action"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:minWidth="200dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:background="@drawable/outlined_button"
        android:textColor="#000000"
        android:textSize="17sp"
        android:textAllCaps="false" />
</LinearLayout>
